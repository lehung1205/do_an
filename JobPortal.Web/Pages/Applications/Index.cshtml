@page
@model JobPortal.Web.Pages.Applications.IndexModel
@{
    ViewData["Title"] = "Đơn ứng tuyển của tôi";
    var total = Model.Applications.Count;
}

<div class="seeker-apps">
    <div class="container seeker-apps__container py-4 mb-5">
        <header class="seeker-apps-hero">
            <div class="seeker-apps-hero__text">
                <p class="seeker-apps-hero__eyebrow">
                    <i class="bi bi-inboxes"></i> Hồ sơ ứng tuyển
                </p>
                <h1 class="seeker-apps-hero__title">Đơn ứng tuyển của tôi</h1>
                <p class="seeker-apps-hero__subtitle">
                    Theo dõi trạng thái từng đơn, xem thông tin việc làm và liên hệ nhà tuyển dụng khi cần.
                </p>
            </div>
            @if (total > 0)
            {
                <div class="seeker-apps-hero__total" aria-label="Tổng số đơn">
                    <span class="seeker-apps-hero__total-value">@total</span>
                    <span class="seeker-apps-hero__total-label">đơn đã nộp</span>
                </div>
            }
        </header>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger border-0 shadow-sm">@Model.ErrorMessage</div>
        }
        else if (total == 0)
        {
            <div class="seeker-apps-empty">
                <div class="seeker-apps-empty__icon" aria-hidden="true">
                    <i class="bi bi-send"></i>
                </div>
                <h2 class="h5 mb-2">Chưa có đơn ứng tuyển</h2>
                <p class="text-muted mb-4">Khám phá việc làm phù hợp và nộp CV để bắt đầu theo dõi tại đây.</p>
                <a asp-page="/Jobs/Index" class="btn seeker-apps-btn seeker-apps-btn--primary">
                    <i class="bi bi-search me-1"></i>Tìm việc làm
                </a>
            </div>
        }
        else
        {
            <nav class="seeker-apps-stats" aria-label="Lọc theo trạng thái">
                <a asp-page="/Applications/Index"
                   asp-route-status="all"
                   asp-route-q="@Model.Search"
                   class="seeker-apps-stat @(Model.StatusFilter == "all" ? "is-active" : "")">
                    <span class="seeker-apps-stat__label">Tất cả</span>
                    <span class="seeker-apps-stat__value">@total</span>
                </a>
                <a asp-page="/Applications/Index"
                   asp-route-status="pending_response"
                   asp-route-q="@Model.Search"
                   class="seeker-apps-stat seeker-apps-stat--pending @(Model.StatusFilter == "pending_response" ? "is-active" : "")">
                    <span class="seeker-apps-stat__label">Chưa phản hồi</span>
                    <span class="seeker-apps-stat__value">@Model.PendingResponseCount</span>
                </a>
                <a asp-page="/Applications/Index"
                   asp-route-status="accepted"
                   asp-route-q="@Model.Search"
                   class="seeker-apps-stat seeker-apps-stat--accepted @(Model.StatusFilter == "accepted" ? "is-active" : "")">
                    <span class="seeker-apps-stat__label">Đã chấp nhận</span>
                    <span class="seeker-apps-stat__value">@Model.AcceptedCount</span>
                </a>
                <a asp-page="/Applications/Index"
                   asp-route-status="rejected"
                   asp-route-q="@Model.Search"
                   class="seeker-apps-stat seeker-apps-stat--rejected @(Model.StatusFilter == "rejected" ? "is-active" : "")">
                    <span class="seeker-apps-stat__label">Đã từ chối</span>
                    <span class="seeker-apps-stat__value">@Model.RejectedCount</span>
                </a>
            </nav>

            <form method="get" class="seeker-apps-filter">
                <div class="seeker-apps-filter__grid">
                    <div class="seeker-apps-filter__field">
                        <label class="form-label" for="status">Trạng thái</label>
                        <select class="form-select" id="status" name="status">
                            @if (Model.StatusFilter == "all")
                            {
                                <option value="all" selected>Tất cả</option>
                            }
                            else
                            {
                                <option value="all">Tất cả</option>
                            }
                            @if (Model.StatusFilter == "pending_response")
                            {
                                <option value="pending_response" selected>Chưa phản hồi</option>
                            }
                            else
                            {
                                <option value="pending_response">Chưa phản hồi</option>
                            }
                            @if (Model.StatusFilter == "accepted")
                            {
                                <option value="accepted" selected>Đã chấp nhận</option>
                            }
                            else
                            {
                                <option value="accepted">Đã chấp nhận</option>
                            }
                            @if (Model.StatusFilter == "rejected")
                            {
                                <option value="rejected" selected>Đã từ chối</option>
                            }
                            else
                            {
                                <option value="rejected">Đã từ chối</option>
                            }
                        </select>
                    </div>
                    <div class="seeker-apps-filter__field seeker-apps-filter__field--search">
                        <label class="form-label" for="q">Tìm kiếm</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input id="q" name="q" type="search" class="form-control border-start-0"
                                   value="@Model.Search"
                                   placeholder="Công việc, công ty, địa điểm, CV..." />
                        </div>
                    </div>
                    <div class="seeker-apps-filter__actions">
                        <button type="submit" class="btn seeker-apps-btn seeker-apps-btn--primary w-100">
                            <i class="bi bi-funnel me-1"></i>Lọc
                        </button>
                        @if (Model.HasActiveFilter)
                        {
                            <a asp-page="/Applications/Index" class="btn seeker-apps-btn seeker-apps-btn--muted w-100">
                                <i class="bi bi-x-lg me-1"></i>Xóa lọc
                            </a>
                        }
                    </div>
                </div>
            </form>

            <p class="seeker-apps-toolbar">
                Hiển thị <strong>@Model.FilteredApplications.Count</strong> / @total đơn
            </p>

            @if (Model.FilteredApplications.Count == 0)
            {
                <div class="seeker-apps-empty seeker-apps-empty--compact">
                    <i class="bi bi-funnel display-6 text-muted mb-2 d-block"></i>
                    <p class="mb-3 text-muted">Không có đơn phù hợp bộ lọc.</p>
                    <a asp-page="/Applications/Index" class="btn btn-sm seeker-apps-btn seeker-apps-btn--info">Xem tất cả đơn</a>
                </div>
            }
            else
            {
                <div class="seeker-apps-list">
                    @foreach (var app in Model.FilteredApplications)
                    {
                        var statusKey = app.Status.Trim().ToLowerInvariant();
                        var isAccepted = string.Equals(statusKey, "accepted", StringComparison.Ordinal);
                        var isJobClosed = string.Equals(app.JobPostingStatus, "closed", StringComparison.OrdinalIgnoreCase);
                        <article class="seeker-app-card @IndexModel.StatusCardModifier(app.Status)">
                            <div class="seeker-app-card__media">
                                @if (!string.IsNullOrWhiteSpace(app.JobThumbnailUrl))
                                {
                                    <img src="@app.JobThumbnailUrl" alt="" class="seeker-app-card__img" loading="lazy" />
                                }
                                else
                                {
                                    <div class="seeker-app-card__img-placeholder" aria-hidden="true">
                                        <i class="bi bi-briefcase"></i>
                                    </div>
                                }
                            </div>

                            <div class="seeker-app-card__body">
                                <div class="seeker-app-card__top">
                                    <div class="seeker-app-card__headline">
                                        <h2 class="seeker-app-card__title">
                                            <a asp-page="/Jobs/Detail" asp-route-id="@app.JobId">@app.JobTitle</a>
                                        </h2>
                                        <p class="seeker-app-card__company">
                                            <i class="bi bi-building"></i>
                                            @app.EmployerName
                                            <span class="seeker-app-card__dot">·</span>
                                            <i class="bi bi-tag"></i>
                                            @app.CategoryName
                                        </p>
                                    </div>
                                    <span class="seeker-app-card__status">@IndexModel.FormatStatus(app.Status)</span>
                                </div>

                                @{
                                    var hint = IndexModel.StatusHint(app.Status);
                                }
                                @if (!string.IsNullOrEmpty(hint))
                                {
                                    <p class="seeker-app-card__hint">
                                        <i class="bi bi-info-circle"></i> @hint
                                    </p>
                                }

                                <ul class="seeker-app-card__facts">
                                    <li>
                                        <i class="bi bi-geo-alt"></i>
                                        <span>@app.JobLocation</span>
                                    </li>
                                    <li>
                                        <i class="bi bi-cash-stack"></i>
                                        <span>@app.JobSalary</span>
                                    </li>
                                    @if (!string.IsNullOrWhiteSpace(app.JobWorkingHours))
                                    {
                                        <li>
                                            <i class="bi bi-clock"></i>
                                            <span>@app.JobWorkingHours</span>
                                        </li>
                                    }
                                    <li>
                                        <i class="bi bi-calendar-event"></i>
                                        <span>Hết hạn tin @app.JobExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                    </li>
                                    <li>
                                        <i class="bi bi-send"></i>
                                        <span>Nộp @IndexModel.FormatRelativeApplied(app.AppliedAt)</span>
                                    </li>
                                </ul>

                                <div class="seeker-app-card__chips">
                                    @if (isJobClosed)
                                    {
                                        <span class="seeker-app-chip seeker-app-chip--muted">
                                            <i class="bi bi-lock"></i> @IndexModel.FormatJobPostingStatus(app.JobPostingStatus)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="seeker-app-chip seeker-app-chip--open">
                                            <i class="bi bi-broadcast"></i> @IndexModel.FormatJobPostingStatus(app.JobPostingStatus)
                                        </span>
                                    }
                                    <span class="seeker-app-chip seeker-app-chip--resume">
                                        <i class="bi bi-file-earmark-person"></i>
                                        @if (!string.IsNullOrWhiteSpace(app.ResumeUrl))
                                        {
                                            <a href="@app.ResumeUrl" target="_blank" rel="noopener noreferrer">@app.ResumeTitle</a>
                                        }
                                        else
                                        {
                                            @app.ResumeTitle
                                        }
                                    </span>
                                    <span class="seeker-app-chip seeker-app-chip--id">#@app.Id</span>
                                </div>
                            </div>

                            <footer class="seeker-app-card__footer">
                                <a asp-page="/Messages/Index" asp-route-applicationId="@app.Id"
                                   class="btn btn-sm seeker-apps-btn seeker-apps-btn--muted">
                                    <i class="bi bi-chat-dots me-1"></i>Nhắn tin
                                </a>
                                <a asp-page="/Jobs/Detail" asp-route-id="@app.JobId"
                                   class="btn btn-sm seeker-apps-btn seeker-apps-btn--info">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem tin
                                </a>
                                @if (isAccepted)
                                {
                                    <a asp-page="/Applications/WorkProgress/Detail" asp-route-applicationId="@app.Id"
                                       class="btn btn-sm seeker-apps-btn seeker-apps-btn--primary">
                                        <i class="bi bi-kanban me-1"></i>Tiến độ CV
                                    </a>
                                }
                            </footer>
                        </article>
                    }
                </div>
            }
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/seeker-applications.css" asp-append-version="true" />
}
