@page
@model JobPortal.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Việc làm";
}

<div class="container py-4">
    <h2 class="mb-4">Danh sách việc làm</h2>

    @if (Model.Jobs.Count == 0)
    {
        <p class="text-muted">Chưa có tin tuyển dụng nào.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 g-lg-4 job-grid">
            @foreach (var job in Model.Jobs)
            {
                <div class="col d-flex">
                    <partial name="Shared/_JobGridCard" model="JobPortal.Web.Models.JobGridCardModel.FromJobDto(job)" />
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <p class="text-muted small text-center mb-2 mt-4">
                Trang @Model.CurrentPage / @Model.TotalPages
            </p>
            <nav class="mt-3" aria-label="Phân trang danh sách việc làm">
                <ul class="pagination justify-content-center flex-wrap mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="/Jobs/Index"
                           asp-route-pageNumber="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           aria-label="Trang trước">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-page="/Jobs/Index"
                               asp-route-pageNumber="@i"
                               asp-route-pageSize="@Model.PageSize">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="/Jobs/Index"
                           asp-route-pageNumber="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           aria-label="Trang sau">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
