<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobPortal.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-body">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand site-brand" asp-page="/Index">
                    <i class="bi bi-briefcase-fill me-2"></i>JobPortal
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @{
                    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("JwtToken"));
                    var userName = Context.Session.GetString("UserName");
                    var userRole = Context.Session.GetString("UserRole");
                    var isJobSeeker = string.Equals(userRole, "JOB_SEEKER", StringComparison.Ordinal);
                    var isEmployer = string.Equals(userRole, "EMPLOYER", StringComparison.Ordinal);
                    var userAvatarUrl = Context.Session.GetString("UserAvatarUrl");
                    var userInitials = JobPortal.Web.Models.AccountPanelViewModel.GetInitials(userName);
                }
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1">
                        @if (isLoggedIn && isEmployer)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Employer/Jobs">Tin tuyển dụng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Employer/Applicants">Ứng viên</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Employer/WorkProgress/Index">Tiến độ làm việc</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Employer/PostJob">Đăng tin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Employer/BuyPackages">Gói dịch vụ</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Jobs/Index">Việc làm</a>
                            </li>
                            @if (isLoggedIn && isJobSeeker)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Applications/Index">Đơn ứng tuyển</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Applications/WorkProgress/Index">Tiến độ làm việc</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2 nav-auth">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item dropdown nav-account">
                                <button class="btn nav-avatar dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="Menu tài khoản">
                                    @if (!string.IsNullOrWhiteSpace(userAvatarUrl))
                                    {
                                        <img src="@userAvatarUrl" alt="" class="nav-avatar__circle nav-avatar__img" width="40" height="40" />
                                    }
                                    else
                                    {
                                        <span class="nav-avatar__circle">@userInitials</span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li class="dropdown-header small text-muted">@userName</li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-account-open data-account-tab="view">
                                            <i class="bi bi-person me-2"></i> Thông tin cá nhân
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-account-open data-account-tab="edit">
                                            <i class="bi bi-pencil me-2"></i> Chỉnh sửa thông tin
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-account-open data-account-tab="password">
                                            <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                                        </button>
                                    </li>
                                    @if (isJobSeeker)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Applications/Index">
                                                <i class="bi bi-inbox me-2"></i> Đơn ứng tuyển
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Applications/WorkProgress/Index">
                                                <i class="bi bi-graph-up-arrow me-2"></i> Tiến độ làm việc
                                            </a>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item"
                                                    data-account-open data-account-tab="resume">
                                                <i class="bi bi-file-earmark-person me-2"></i> Thêm hồ sơ
                                            </button>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-page="/Auth/Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm px-3" asp-page="/Auth/Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-page="/Auth/Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <a class="site-brand text-white text-decoration-none" asp-page="/Index">
                        <i class="bi bi-briefcase-fill me-2"></i>JobPortal
                    </a>
                    <p class="small text-white-50 mt-2 mb-0">Nền tảng kết nối ứng viên và nhà tuyển dụng.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a class="text-white-50 small text-decoration-none me-3" asp-page="/Privacy">Chính sách</a>
                    <span class="text-white-50 small">&copy; @DateTime.Now.Year JobPortal</span>
                </div>
            </div>
        </div>
    </footer>

    @if (isLoggedIn)
    {
        @await Component.InvokeAsync("AccountPanel")
        <partial name="_ValidationScriptsPartial" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
