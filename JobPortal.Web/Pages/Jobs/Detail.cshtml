@page "{id:long}"
@model JobPortal.Web.Pages.Jobs.DetailModel
@{
    ViewData["Title"] = Model.Job.tieu_de;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Jobs/Index">Việc làm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="h2 mb-1">@Model.Job.tieu_de</h1>
                            <p class="text-primary h5 mb-0">Nhà tuyển dụng #@Model.Job.id_tuyen_dung</p>
                        </div>
                        <span class="badge bg-success p-2">@Model.Job.trang_thai_bai_dang</span>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mb-4 text-muted">
                        <span><i class="bi bi-geo-alt"></i> @Model.Job.dia_diem</span>
                        <span><i class="bi bi-currency-dollar"></i> @Model.Job.muc_luong.ToString("N0") VNĐ</span>
                    </div>

                    <hr />

                    <div class="job-description mt-4">
                        <h4 class="mb-3">Mô tả công việc</h4>
                        <div style="white-space: pre-wrap;">@Model.Job.mo_ta</div>
                    </div>

                    <div class="mt-5">
                        <button class="btn btn-primary btn-lg px-5">Ứng tuyển ngay</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title mb-3">Thông tin tóm tắt</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><strong>Mức lương:</strong> @Model.Job.muc_luong.ToString("N0") VNĐ</li>
                        <li class="mb-2"><strong>Mã nhà tuyển dụng:</strong> @Model.Job.id_tuyen_dung</li>
                        <li class="mb-2"><strong>Địa điểm:</strong> @Model.Job.dia_diem</li>
                        <li class="mb-2"><strong>Hết hạn:</strong> @Model.Job.ngay_het_han.ToString("dd/MM/yyyy")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .job-description {
        line-height: 1.7;
        color: #444;
    }
    .breadcrumb-item a {
        text-decoration: none;
    }
</style>
