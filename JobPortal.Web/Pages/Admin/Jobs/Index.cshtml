@page
@model JobPortal.Web.Pages.Admin.Jobs.IndexModel
@using JobPortal.Web.Models
@using JobsPage = JobPortal.Web.Pages.Admin.Jobs.IndexModel
@{
    ViewData["Title"] = "Duyệt tin tuyển dụng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-jobs.css" asp-append-version="true" />
}

<div class="admin-portal">
    <div class="container admin-portal__container py-4">

        <header class="admin-jobs-hero">
            <div class="admin-jobs-hero__text">
                <p class="admin-jobs-hero__eyebrow">
                    <i class="bi bi-shield-check"></i> Kiểm duyệt
                </p>
                <h1 class="admin-jobs-hero__title">Duyệt tin tuyển dụng</h1>
                <p class="admin-jobs-hero__subtitle">
                    Phê duyệt hoặc từ chối tin đăng của nhà tuyển dụng. Tin chờ quá 24 giờ có thể được hệ thống tự duyệt.
                    Từ chối sẽ hoàn lượt đăng tin cho NTD.
                </p>
            </div>
            @if (Model.Summary != null)
            {
                <div class="admin-jobs-hero__kpis" aria-label="Tổng quan tin">
                    <div class="admin-jobs-hero__kpi">
                        <span class="admin-jobs-hero__kpi-value admin-jobs-hero__kpi-value--warn">@Model.Summary.PendingCount</span>
                        <span class="admin-jobs-hero__kpi-label">Chờ duyệt</span>
                    </div>
                    <div class="admin-jobs-hero__kpi">
                        <span class="admin-jobs-hero__kpi-value admin-jobs-hero__kpi-value--success">@Model.Summary.RecruitingCount</span>
                        <span class="admin-jobs-hero__kpi-label">Đang tuyển</span>
                    </div>
                    <div class="admin-jobs-hero__kpi">
                        <span class="admin-jobs-hero__kpi-value">@Model.Summary.RejectedCount</span>
                        <span class="admin-jobs-hero__kpi-label">Từ chối</span>
                    </div>
                </div>
            }
        </header>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success admin-jobs-alert shadow-sm">@Model.SuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ActionErrorMessage))
        {
            <div class="alert alert-warning admin-jobs-alert shadow-sm">@Model.ActionErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-warning admin-jobs-alert shadow-sm">@Model.ErrorMessage</div>
        }

        @if (string.IsNullOrEmpty(Model.ErrorMessage) || Model.Jobs.Count > 0 || Model.HasActiveFilter)
        {
            <nav class="admin-jobs-stats" aria-label="Lọc theo trạng thái tin">
                <a asp-page="/Admin/Jobs/Index"
                   asp-route-status="@JobsPage.StatusPending"
                   asp-route-q="@Model.Search"
                   asp-route-pageNumber="1"
                   asp-route-pageSize="@Model.PageSize"
                   class="admin-jobs-stat admin-jobs-stat--pending @(Model.StatusFilter == JobsPage.StatusPending ? "is-active" : "")">
                    <span class="admin-jobs-stat__label">Chờ duyệt</span>
                    <span class="admin-jobs-stat__value">@(Model.Summary?.PendingCount ?? 0)</span>
                </a>
                <a asp-page="/Admin/Jobs/Index"
                   asp-route-status="@JobsPage.StatusApproved"
                   asp-route-q="@Model.Search"
                   asp-route-pageNumber="1"
                   asp-route-pageSize="@Model.PageSize"
                   class="admin-jobs-stat admin-jobs-stat--approved @(Model.StatusFilter == JobsPage.StatusApproved ? "is-active" : "")">
                    <span class="admin-jobs-stat__label">Đã duyệt</span>
                    <span class="admin-jobs-stat__value">@(Model.Summary?.RecruitingCount ?? 0)</span>
                </a>
                <a asp-page="/Admin/Jobs/Index"
                   asp-route-status="@JobsPage.StatusRejected"
                   asp-route-q="@Model.Search"
                   asp-route-pageNumber="1"
                   asp-route-pageSize="@Model.PageSize"
                   class="admin-jobs-stat admin-jobs-stat--rejected @(Model.StatusFilter == JobsPage.StatusRejected ? "is-active" : "")">
                    <span class="admin-jobs-stat__label">Từ chối</span>
                    <span class="admin-jobs-stat__value">@(Model.Summary?.RejectedCount ?? 0)</span>
                </a>
                <a asp-page="/Admin/Jobs/Index"
                   asp-route-status="@JobsPage.StatusAll"
                   asp-route-q="@Model.Search"
                   asp-route-pageNumber="1"
                   asp-route-pageSize="@Model.PageSize"
                   class="admin-jobs-stat @(Model.StatusFilter == JobsPage.StatusAll ? "is-active" : "")">
                    <span class="admin-jobs-stat__label">Tất cả</span>
                    <span class="admin-jobs-stat__value">@Model.AllTabCount</span>
                </a>
            </nav>

            <form method="get" class="admin-jobs-filter">
                <input type="hidden" name="status" value="@Model.StatusFilter" />
                <input type="hidden" name="pageNumber" value="1" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="admin-jobs-filter__grid">
                    <div class="admin-jobs-filter__search">
                        <label class="form-label" for="q">Tìm kiếm</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="search" class="form-control border-start-0" id="q" name="q" value="@Model.Search"
                                   placeholder="Tiêu đề, mô tả, địa điểm, công ty..." maxlength="200" />
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="btn admin-payments__btn admin-payments__btn--filter w-100">
                            <i class="bi bi-funnel me-1"></i>Lọc
                        </button>
                    </div>
                    <div>
                        <a class="btn admin-payments__btn admin-payments__btn--excel w-100"
                           asp-page="/Admin/Jobs/Index"
                           asp-page-handler="ExportJobsExcel"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-q="@Model.Search"
                           title="Xuất danh sách theo bộ lọc hiện tại">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </a>
                    </div>
                    <div>
                        @if (Model.HasActiveFilter)
                        {
                            <a asp-page="/Admin/Jobs/Index"
                               asp-route-status="@Model.StatusFilter"
                               class="btn admin-payments__btn admin-payments__btn--clear w-100">
                                <i class="bi bi-x-lg me-1"></i>Xóa lọc
                            </a>
                        }
                        else
                        {
                            <span class="btn admin-payments__btn admin-payments__btn--clear w-100 disabled opacity-50" aria-disabled="true">
                                <i class="bi bi-x-lg me-1"></i>Xóa lọc
                            </span>
                        }
                    </div>
                </div>
            </form>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage) && Model.Jobs.Count == 0)
        {
            <div class="admin-jobs-empty">
                <div class="admin-jobs-empty__icon" aria-hidden="true"><i class="bi bi-exclamation-circle"></i></div>
                <p class="text-muted mb-0">@Model.ErrorMessage</p>
            </div>
        }
        else if (Model.Jobs.Count == 0)
        {
            <div class="admin-jobs-empty admin-jobs-empty--compact">
                <div class="admin-jobs-empty__icon" aria-hidden="true"><i class="bi bi-inbox"></i></div>
                <p class="mb-3 text-muted">@Model.EmptyListMessage</p>
                @if (Model.HasActiveFilter)
                {
                    <a asp-page="/Admin/Jobs/Index" asp-route-status="@Model.StatusFilter"
                       class="btn btn-sm admin-payments__btn admin-payments__btn--filter">Xóa bộ lọc</a>
                }
            </div>
        }
        else
        {
            <p class="admin-jobs-toolbar">
                Hiển thị <strong>@Model.Jobs.Count</strong> / @Model.TotalCount @Model.ListSummaryLabel
                @if (Model.HasActiveFilter)
                {
                    <span>· đang lọc</span>
                }
            </p>

            <div class="admin-jobs-list">
                @foreach (var job in Model.Jobs)
                {
                    var statusKey = job.PostingStatus.Trim().ToLowerInvariant();
                    var showModerationActions = string.Equals(statusKey, JobsPage.StatusPending, StringComparison.Ordinal);
                    var hint = JobsPage.StatusHint(job.PostingStatus, job.CreatedAt);
                    var daysLeft = JobsPage.DaysUntilExpiry(job.ExpiryDate);
                    var desc = string.IsNullOrWhiteSpace(job.DescriptionPreview) ? job.Description : job.DescriptionPreview;

                    <article class="admin-job-card @JobsPage.StatusCardModifier(job.PostingStatus)">
                        <div class="admin-job-card__media">
                            @if (!string.IsNullOrWhiteSpace(job.ThumbnailUrl))
                            {
                                <img src="@job.ThumbnailUrl" alt="" class="admin-job-card__thumb" loading="lazy" />
                            }
                            else
                            {
                                <div class="admin-job-card__thumb-placeholder" aria-hidden="true">
                                    <i class="bi bi-briefcase"></i>
                                </div>
                            }
                        </div>

                        <div class="admin-job-card__body">
                            <div class="admin-job-card__top">
                                <h2 class="admin-job-card__title">
                                    @if (showModerationActions)
                                    {
                                        @job.Title
                                    }
                                    else
                                    {
                                        <a asp-page="/Jobs/Detail" asp-route-id="@job.Id" target="_blank" rel="noopener noreferrer">@job.Title</a>
                                    }
                                </h2>
                                <span class="admin-jobs-badge @JobsPage.StatusBadgeClass(job.PostingStatus)">
                                    @JobsPage.FormatStatus(job.PostingStatus)
                                </span>
                            </div>

                            <div class="admin-job-card__employer">
                                <span class="admin-job-card__employer-avatar" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(job.EmployerImage))
                                    {
                                        <img src="@job.EmployerImage" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-building"></i>
                                    }
                                </span>
                                <div class="min-w-0">
                                    <p class="admin-job-card__employer-name">@job.EmployerName</p>
                                    <p class="admin-job-card__employer-meta mb-0">
                                        @if (!string.IsNullOrWhiteSpace(job.EmployerEmail))
                                        {
                                            <i class="bi bi-envelope me-1"></i>@job.EmployerEmail
                                        }
                                        @if (!string.IsNullOrWhiteSpace(job.EmployerPhone))
                                        {
                                            <span class="mx-1">·</span>
                                            <i class="bi bi-telephone me-1"></i>@job.EmployerPhone
                                        }
                                        <span class="mx-1">·</span>
                                        <i class="bi bi-hash"></i>NTD #@job.EmployerId
                                    </p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(desc))
                            {
                                <p class="admin-job-card__desc">@desc</p>
                            }

                            @if (!string.IsNullOrEmpty(hint))
                            {
                                <p class="admin-job-card__hint @(showModerationActions && JobsPage.IsEligibleForAutoApprove(job.CreatedAt) ? "" : "admin-job-card__hint--info")">
                                    <i class="bi bi-lightbulb"></i> @hint
                                </p>
                            }

                            <ul class="admin-job-card__facts">
                                <li><i class="bi bi-geo-alt"></i><span>@job.Location</span></li>
                                <li><i class="bi bi-cash-stack"></i><span>@job.Salary</span></li>
                                @if (!string.IsNullOrWhiteSpace(job.WorkingHours))
                                {
                                    <li><i class="bi bi-clock"></i><span>@job.WorkingHours</span></li>
                                }
                                <li>
                                    <i class="bi bi-calendar-plus"></i>
                                    <span>Đăng @JobsPage.FormatDateTime(job.CreatedAt) (@JobsPage.FormatRelativeCreated(job.CreatedAt))</span>
                                </li>
                                <li>
                                    <i class="bi bi-calendar-event"></i>
                                    <span>Hết hạn @JobsPage.FormatDate(job.ExpiryDate) · còn @daysLeft ngày</span>
                                </li>
                            </ul>

                            <div class="admin-job-card__chips">
                                <span class="admin-jobs-chip admin-jobs-chip--category">
                                    <i class="bi bi-tag"></i> @job.CategoryName
                                </span>
                                <span class="admin-jobs-chip admin-jobs-chip--applicants">
                                    <i class="bi bi-people"></i> @job.ApplicantCount ứng viên
                                </span>
                                @if (job.ImageCount > 0)
                                {
                                    <span class="admin-jobs-chip">
                                        <i class="bi bi-images"></i> @job.ImageCount ảnh
                                    </span>
                                }
                                @if (showModerationActions && JobsPage.IsEligibleForAutoApprove(job.CreatedAt))
                                {
                                    <span class="admin-jobs-chip admin-jobs-chip--auto">
                                        <i class="bi bi-lightning"></i> Đủ điều kiện tự duyệt
                                    </span>
                                }
                                <span class="admin-jobs-chip">#@job.Id</span>
                            </div>
                        </div>

                        <footer class="admin-job-card__footer">
                            @if (showModerationActions)
                            {
                                <form method="post" asp-page-handler="Approve" class="d-inline"
                                      id="admin-moderate-form-approve-@job.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@job.Id" />
                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                    <input type="hidden" name="q" value="@Model.Search" />
                                    <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="d-none" tabindex="-1" aria-hidden="true">Submit</button>
                                    <button type="button"
                                            class="btn btn-sm admin-jobs-btn admin-jobs-btn--approve js-admin-job-moderate"
                                            data-bs-toggle="modal"
                                            data-bs-target="#adminJobModerateModal"
                                            data-moderate-action="approve"
                                            data-moderate-form="admin-moderate-form-approve-@job.Id"
                                            data-job-title="@job.Title">
                                        <i class="bi bi-check-lg me-1"></i>Duyệt tin
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" class="d-inline"
                                      id="admin-moderate-form-reject-@job.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@job.Id" />
                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                    <input type="hidden" name="q" value="@Model.Search" />
                                    <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button type="submit" class="d-none" tabindex="-1" aria-hidden="true">Submit</button>
                                    <button type="button"
                                            class="btn btn-sm admin-jobs-btn admin-jobs-btn--reject js-admin-job-moderate"
                                            data-bs-toggle="modal"
                                            data-bs-target="#adminJobModerateModal"
                                            data-moderate-action="reject"
                                            data-moderate-form="admin-moderate-form-reject-@job.Id"
                                            data-job-title="@job.Title">
                                        <i class="bi bi-x-lg me-1"></i>Từ chối
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-page="/Jobs/Detail" asp-route-id="@job.Id" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-sm admin-jobs-btn admin-jobs-btn--view">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem tin công khai
                                </a>
                            }
                        </footer>
                    </article>
                }
            </div>

            @if (Model.ShowPagination)
            {
                <nav class="admin-jobs-pagination" aria-label="Phân trang duyệt tin">
                    <ul class="pagination justify-content-center flex-wrap mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/Jobs/Index"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-q="@Model.Search">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Admin/Jobs/Index"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-q="@Model.Search">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/Jobs/Index"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-q="@Model.Search">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-muted small text-center mt-2 mb-0">
                        Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount @Model.ListSummaryLabel
                    </p>
                </nav>
            }
        }
    </div>
</div>

<div class="modal fade admin-job-moderate-modal" id="adminJobModerateModal" tabindex="-1"
     aria-labelledby="adminJobModerateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <div class="admin-job-moderate-modal__icon" id="adminJobModerateModalIcon" aria-hidden="true">
                    <i class="bi bi-check-lg"></i>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title admin-job-moderate-modal__title" id="adminJobModerateModalLabel">
                    Xác nhận duyệt tin
                </h5>
                <p class="admin-job-moderate-modal__lead mb-2" id="adminJobModerateModalLead">
                    Tin sẽ hiển thị công khai cho ứng viên.
                </p>
                <div class="admin-job-moderate-modal__job" id="adminJobModerateModalJobTitle"></div>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn admin-jobs-btn admin-jobs-btn--view" data-bs-dismiss="modal">
                    Hủy
                </button>
                <button type="submit"
                        class="btn admin-jobs-btn admin-jobs-btn--approve"
                        id="adminJobModerateModalConfirm"
                        disabled
                        aria-disabled="true">
                    <i class="bi bi-check-lg me-1"></i> Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('adminJobModerateModal');
            if (!modalEl) return;

            var confirmBtn = document.getElementById('adminJobModerateModalConfirm');
            var iconEl = document.getElementById('adminJobModerateModalIcon');
            var titleEl = document.getElementById('adminJobModerateModalLabel');
            var leadEl = document.getElementById('adminJobModerateModalLead');
            var jobTitleEl = document.getElementById('adminJobModerateModalJobTitle');

            var copy = {
                approve: {
                    modalClass: 'admin-job-moderate-modal--approve',
                    iconClass: 'bi-check-lg',
                    title: 'Xác nhận duyệt tin',
                    lead: 'Tin sẽ hiển thị công khai cho ứng viên sau khi bạn xác nhận.',
                    confirmLabel: 'Xác nhận duyệt',
                    confirmBtnClass: 'admin-jobs-btn--approve',
                    confirmIcon: 'bi-check-lg'
                },
                reject: {
                    modalClass: 'admin-job-moderate-modal--reject',
                    iconClass: 'bi-x-lg',
                    title: 'Xác nhận từ chối tin',
                    lead: 'Lượt đăng tin sẽ được hoàn lại cho nhà tuyển dụng. Tin sẽ không hiển thị công khai.',
                    confirmLabel: 'Xác nhận từ chối',
                    confirmBtnClass: 'admin-jobs-btn--reject',
                    confirmIcon: 'bi-x-lg'
                }
            };

            function getTrigger(el) {
                return el && el.closest ? el.closest('.js-admin-job-moderate') : null;
            }

            function bindForm(trigger) {
                var action = trigger.getAttribute('data-moderate-action');
                var cfg = copy[action];
                if (!cfg || !confirmBtn) return;

                var formId = trigger.getAttribute('data-moderate-form');
                var jobTitle = trigger.getAttribute('data-job-title') || '';

                modalEl.classList.remove('admin-job-moderate-modal--approve', 'admin-job-moderate-modal--reject');
                modalEl.classList.add(cfg.modalClass);

                if (iconEl) iconEl.innerHTML = '<i class="bi ' + cfg.iconClass + '"></i>';
                if (titleEl) titleEl.textContent = cfg.title;
                if (leadEl) leadEl.textContent = cfg.lead;
                if (jobTitleEl) {
                    jobTitleEl.textContent = jobTitle;
                    jobTitleEl.hidden = !jobTitle;
                }

                confirmBtn.className = 'btn admin-jobs-btn ' + cfg.confirmBtnClass;
                confirmBtn.innerHTML = '<i class="bi ' + cfg.confirmIcon + ' me-1"></i> ' + cfg.confirmLabel;

                if (formId && document.getElementById(formId)) {
                    confirmBtn.setAttribute('form', formId);
                    confirmBtn.disabled = false;
                    confirmBtn.removeAttribute('aria-disabled');
                } else {
                    confirmBtn.removeAttribute('form');
                    confirmBtn.disabled = true;
                    confirmBtn.setAttribute('aria-disabled', 'true');
                }
            }

            document.querySelectorAll('.js-admin-job-moderate').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    var trigger = getTrigger(e.currentTarget);
                    if (trigger) bindForm(trigger);
                });
            });

            modalEl.addEventListener('show.bs.modal', function (e) {
                var trigger = getTrigger(e.relatedTarget);
                if (trigger) bindForm(trigger);
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                if (!confirmBtn) return;
                confirmBtn.removeAttribute('form');
                confirmBtn.disabled = true;
                confirmBtn.setAttribute('aria-disabled', 'true');
            });
        })();
    </script>
}
