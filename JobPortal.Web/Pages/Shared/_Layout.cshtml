@{
    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("JwtToken"));
    var layoutUserRole = Context.Session.GetString("UserRole");
    var layoutIsEmployer = string.Equals(layoutUserRole, "EMPLOYER", StringComparison.Ordinal);
    var isEmployerPortalChrome = layoutIsEmployer
        && ViewData["EmployerPortalChrome"] as bool? == true;
    var layoutCurrentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isAdminPortalChrome = string.Equals(layoutUserRole, "ADMIN", StringComparison.Ordinal)
        && (ViewData["AdminPortalChrome"] as bool? == true
            || layoutCurrentPage.StartsWith("/Admin/", StringComparison.OrdinalIgnoreCase));
    var showN8nChatbot = JobPortal.Web.Pages.Chatbot.WebhookModel.IsChatbotAllowed(isLoggedIn, layoutUserRole);
    var showNotificationDropdownAssets = isLoggedIn
        && !isAdminPortalChrome
        && (string.Equals(layoutUserRole, "JOB_SEEKER", StringComparison.Ordinal) && !isEmployerPortalChrome
            || layoutIsEmployer && isEmployerPortalChrome);
    var authFocusLayout = ViewData["AuthFocusLayout"] as bool? == true;
    var isAuthRegisterPage = string.Equals(layoutCurrentPage, "/Auth/Register", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/jobsgo-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (showNotificationDropdownAssets)
    {
        <link rel="stylesheet" href="~/css/notification-dropdown.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/JobPortal.Web.styles.css" asp-append-version="true" />
    @if (isAdminPortalChrome)
    {
        <link rel="stylesheet" href="~/css/admin-portal.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("EmployerStyles", required: false)
</head>
<body class="site-body@(isEmployerPortalChrome ? " employer-portal-mode" : "")@(isAdminPortalChrome ? " admin-portal-mode" : "")@(authFocusLayout ? " auth-focus-layout" : "")">
    @if (!isEmployerPortalChrome && !isAdminPortalChrome)
    {
    @if (authFocusLayout)
    {
    <header class="auth-focus-header">
        <div class="auth-focus-header__inner">
            <a class="auth-focus-header__brand" asp-page="/Index">
                <i class="bi bi-briefcase-fill" aria-hidden="true"></i>
                <span>JobPortal</span>
            </a>
            <nav class="auth-focus-header__nav" aria-label="Điều hướng">
                <a class="auth-focus-header__link" asp-page="/Jobs/Index">Việc làm</a>
                <a class="auth-focus-header__link" asp-page="/Privacy">Chính sách</a>
                @if (isAuthRegisterPage)
                {
                    <a class="btn btn-outline-primary btn-sm auth-focus-header__cta" asp-page="/Auth/Login">Đăng nhập</a>
                }
                else
                {
                    <a class="btn btn-primary btn-sm auth-focus-header__cta" asp-page="/Auth/Register">Đăng ký</a>
                }
            </nav>
        </div>
    </header>
    }
    else
    {
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            @{
                var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("JwtToken"));
                var userName = Context.Session.GetString("UserName");
                var userRole = Context.Session.GetString("UserRole");
                var isJobSeeker = string.Equals(userRole, "JOB_SEEKER", StringComparison.Ordinal);
                var isEmployer = string.Equals(userRole, "EMPLOYER", StringComparison.Ordinal);
                var isAdmin = string.Equals(userRole, "ADMIN", StringComparison.Ordinal);
                var userAvatarUrl = Context.Session.GetString("UserAvatarUrl");
                var userInitials = JobPortal.Web.Models.AccountPanelViewModel.GetInitials(userName);
                var isPolicyPage = string.Equals(
                    ViewContext.RouteData.Values["page"]?.ToString(),
                    "/Privacy",
                    StringComparison.OrdinalIgnoreCase);
                var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                var isAdminDashboard = string.Equals(currentPage, "/Admin/Dashboard/Index", StringComparison.OrdinalIgnoreCase);
                var isAdminJobs = string.Equals(currentPage, "/Admin/Jobs/Index", StringComparison.OrdinalIgnoreCase);
                var isAdminUsers = string.Equals(currentPage, "/Admin/Users/Index", StringComparison.OrdinalIgnoreCase);
                var isAdminPayments = string.Equals(currentPage, "/Admin/Payments/Index", StringComparison.OrdinalIgnoreCase);
                var isEmployerStats = isEmployer && (
                    string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase)
                    || string.IsNullOrEmpty(currentPage));
                var isSeekerNotificationsPage = string.Equals(currentPage, "/Notifications/Index", StringComparison.OrdinalIgnoreCase);
                var isSeekerMessagesPage = string.Equals(currentPage, "/Messages/Index", StringComparison.OrdinalIgnoreCase);
            }
            <div class="container">
                <a class="navbar-brand site-brand" asp-page="@(isAdmin ? "/Admin/Dashboard/Index" : "/Index")">
                    <i class="bi bi-briefcase-fill me-2"></i>JobPortal
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1">
                        @if (isLoggedIn && isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isAdminDashboard ? "active fw-semibold" : "")" asp-page="/Admin/Dashboard/Index">Thống kê</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isAdminJobs ? "active fw-semibold" : "")" asp-page="/Admin/Jobs/Index">Duyệt tin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isAdminUsers ? "active fw-semibold" : "")" asp-page="/Admin/Users/Index">Quản lý tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isAdminPayments ? "active fw-semibold" : "")" asp-page="/Admin/Payments/Index">Doanh thu</a>
                            </li>
                        }
                        else if (isLoggedIn && isEmployer)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isEmployerStats ? "active fw-semibold" : "")" asp-page="/Index">Bảng thông tin</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Jobs/Index">Việc làm</a>
                            </li>
                            @if (isLoggedIn && isJobSeeker)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Applications/Index">Đơn ứng tuyển</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Applications/WorkProgress/Index">Tiến độ làm việc</a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link @(isPolicyPage ? "active" : "")" asp-page="/Privacy">
                                <i class="bi bi-shield-check me-1 d-lg-none"></i>Chính sách
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2 nav-auth">
                        @if (isLoggedIn && !isEmployerPortalChrome)
                        {
                            @if (isJobSeeker)
                            {
                                <li class="nav-item nav-quick-actions">
                                    @await Component.InvokeAsync("NotificationDropdown", new { variant = "seeker", isActive = isSeekerNotificationsPage })
                                    <a asp-page="/Messages/Index"
                                       class="site-nav-icon-btn @(isSeekerMessagesPage ? "is-active" : "")"
                                       title="Tin nhắn"
                                       aria-label="Tin nhắn">
                                        <i class="bi bi-chat-dots"></i>
                                        @await Component.InvokeAsync("ChatNavBadge")
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown nav-account">
                                <button class="btn nav-avatar dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="Menu tài khoản">
                                    @if (!string.IsNullOrWhiteSpace(userAvatarUrl))
                                    {
                                        <img src="@userAvatarUrl" alt="" class="nav-avatar__circle nav-avatar__img" width="40" height="40" />
                                    }
                                    else
                                    {
                                        <span class="nav-avatar__circle">@userInitials</span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li class="dropdown-header small text-muted">@userName</li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-account-open data-account-tab="view">
                                            <i class="bi bi-person me-2"></i> Thông tin cá nhân
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-account-open data-account-tab="edit">
                                            <i class="bi bi-pencil me-2"></i> Chỉnh sửa thông tin
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-account-open data-account-tab="password">
                                            <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                                        </button>
                                    </li>
                                    @if (isJobSeeker)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Applications/Index">
                                                <i class="bi bi-inbox me-2"></i> Đơn ứng tuyển
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Applications/WorkProgress/Index">
                                                <i class="bi bi-graph-up-arrow me-2"></i> Tiến độ làm việc
                                            </a>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item"
                                                    data-account-open data-account-tab="resume">
                                                <i class="bi bi-file-earmark-person me-2"></i> Thêm hồ sơ
                                            </button>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-page="/Auth/Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-page="/Auth/Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-page="/Auth/Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }
    }

    <main role="main" class="@(isEmployerPortalChrome ? "employer-portal-main" : "")@(isAdminPortalChrome ? " admin-portal-main" : "")@(authFocusLayout ? " auth-focus-main" : "")">
        @RenderBody()
    </main>

    @if (!authFocusLayout)
    {
        <partial name="_SiteFooter" />
    }

    @if (isLoggedIn)
    {
        @await Component.InvokeAsync("AccountPanel")
        <partial name="_ValidationScriptsPartial" />
    }

    @if (showN8nChatbot)
    {
        <partial name="_N8nChatbot" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (showNotificationDropdownAssets)
    {
        <script src="~/js/notification-dropdown.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("EmployerScripts", required: false)
</body>
</html>
