@model JobPortal.Web.Models.AccountPanelViewModel

<div class="modal fade account-modal" tabindex="-1" id="accountOffcanvas"
     aria-labelledby="accountOffcanvasLabel" aria-hidden="true" data-active-tab="@Model.ActiveTab">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable account-modal__dialog">
        <div class="modal-content account-modal__content">
            <div class="modal-header account-modal__header">
                <div>
                    <h5 class="modal-title account-modal__title mb-0" id="accountOffcanvasLabel">Tài khoản của tôi</h5>
                    <p class="account-modal__subtitle mb-0 mt-1">@Model.Profile.Name</p>
                </div>
                <button type="button" class="account-modal__close" data-bs-dismiss="modal" aria-label="Đóng">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-body account-modal__body p-0 d-flex flex-column">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success py-2 mt-3 mb-0 small account-modal__alerts">@Model.SuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 mt-3 mb-0 small account-modal__alerts">@Model.ErrorMessage</div>
        }

        <div class="account-modal__tabs-wrap pt-3">
        <ul class="nav nav-tabs account-tabs border-0" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="account-tab-view-btn" data-bs-toggle="tab"
                        data-bs-target="#account-tab-view" type="button" role="tab">
                    <i class="bi bi-person me-1"></i> Thông tin
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="account-tab-edit-btn" data-bs-toggle="tab"
                        data-bs-target="#account-tab-edit" type="button" role="tab">
                    <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="account-tab-password-btn" data-bs-toggle="tab"
                        data-bs-target="#account-tab-password" type="button" role="tab">
                    <i class="bi bi-shield-lock me-1"></i> Mật khẩu
                </button>
            </li>
            @if (Model.IsJobSeeker)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="account-tab-resume-btn" data-bs-toggle="tab"
                            data-bs-target="#account-tab-resume" type="button" role="tab">
                        <i class="bi bi-file-earmark-person me-1"></i> Thêm hồ sơ
                    </button>
                </li>
            }
            @if (Model.IsJobSeeker || Model.IsEmployer)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="account-tab-reviews-btn" data-bs-toggle="tab"
                            data-bs-target="#account-tab-reviews" type="button" role="tab">
                        <i class="bi bi-star me-1"></i> Đánh giá
                    </button>
                </li>
            }
        </ul>
        </div>

        <div class="tab-content flex-grow-1 overflow-auto account-modal__tab-content">
            <div class="tab-pane fade show active" id="account-tab-view" role="tabpanel">
                <div class="account-profile-card">
                    <div class="account-profile-card__avatar">
                        @if (!string.IsNullOrWhiteSpace(Model.Profile.ProfileImage))
                        {
                            <img src="@Model.Profile.ProfileImage" alt="" />
                        }
                        else
                        {
                            <span class="account-profile-card__initials">
                                @AccountPanelViewModel.GetInitials(Model.Profile.Name)
                            </span>
                        }
                    </div>
                    <p class="account-profile-card__hint mb-0">
                        Ảnh đại diện có thể đổi trong tab <strong>Chỉnh sửa</strong>.
                    </p>
                </div>
                <div class="account-info-grid">
                    <div class="account-info-row">
                        <span class="account-info-row__label">Họ và tên</span>
                        <span class="account-info-row__value account-info-row__value--strong">@Model.Profile.Name</span>
                    </div>
                    <div class="account-info-row">
                        <span class="account-info-row__label">Email</span>
                        <span class="account-info-row__value">@Model.Profile.Email</span>
                    </div>
                    <div class="account-info-row">
                        <span class="account-info-row__label">Số điện thoại</span>
                        <span class="account-info-row__value">@(string.IsNullOrWhiteSpace(Model.Profile.PhoneNumber) ? "—" : Model.Profile.PhoneNumber)</span>
                    </div>
                    <div class="account-info-row">
                        <span class="account-info-row__label">Loại tài khoản</span>
                        <span class="account-info-row__value">
                            <span class="account-info-row__badge">@AccountPanelViewModel.FormatRole(Model.Profile.Role)</span>
                        </span>
                    </div>
                    <div class="account-info-row">
                        <span class="account-info-row__label">Ngày tham gia</span>
                        <span class="account-info-row__value">@AccountPanelViewModel.FormatDateTime(Model.Profile.CreatedAt)</span>
                    </div>
                    <div class="account-info-row">
                        <span class="account-info-row__label">Cập nhật lần cuối</span>
                        <span class="account-info-row__value">@AccountPanelViewModel.FormatDateTimeNullable(Model.Profile.UpdatedAt)</span>
                    </div>
                    <div class="account-info-row">
                        <span class="account-info-row__label">Trạng thái tài khoản</span>
                        <span class="account-info-row__value">@AccountPanelViewModel.FormatAccountStatus(Model.Profile.AccountStatus)</span>
                    </div>
                    @if (!Model.IsAdmin)
                    {
                        <div class="account-info-row">
                            <span class="account-info-row__label">Ngày sinh</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.FormatDateOnly(Model.Profile.DateOfBirth)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">Giới tính</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.FormatGender(Model.Profile.Gender)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.Description))
                    {
                        <div class="account-info-row">
                            <span class="account-info-row__label">Giới thiệu</span>
                            <span class="account-info-row__value" style="white-space:pre-wrap;">@Model.Profile.Description</span>
                        </div>
                    }
                    @if (Model.IsJobSeeker)
                    {
                        <div class="account-info-row">
                            <span class="account-info-row__label">Địa chỉ thường trú</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.PermanentAddress)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">Địa chỉ tạm trú</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.TemporaryAddress)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">CMND/CCCD</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.IdCard)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">Ngày cấp</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.IdCardIssueDate)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">Nơi cấp</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.IdCardIssuePlace)</span>
                        </div>
                    }
                    @if (string.Equals(Model.Profile.Role, "EMPLOYER", StringComparison.Ordinal))
                    {
                        <div class="account-info-row">
                            <span class="account-info-row__label">CMND/CCCD</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.IdCard)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">Số lượt đăng bài</span>
                            <span class="account-info-row__value">@(Model.Profile.PostingLimit is int pl ? pl.ToString() : "—")</span>
                        </div>
                    }
                    @if (Model.IsAdmin)
                    {
                        <div class="account-info-row">
                            <span class="account-info-row__label">Ngân hàng</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.BankName)</span>
                        </div>
                        <div class="account-info-row">
                            <span class="account-info-row__label">Số tài khoản</span>
                            <span class="account-info-row__value">@AccountPanelViewModel.DashIfEmpty(Model.Profile.BankAccountNumber)</span>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-primary w-100 mt-3" data-account-switch-tab="edit">
                    <i class="bi bi-pencil me-1"></i> Chỉnh sửa thông tin
                </button>
            </div>

            <div class="tab-pane fade" id="account-tab-edit" role="tabpanel">
                <form method="post" enctype="multipart/form-data" action="@Model.UpdateFormAction">
                    <input type="hidden" name="@Model.AntiForgeryFieldName" value="@Model.AntiForgeryRequestToken" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label">Ảnh đại diện</label>
                        @if (!string.IsNullOrWhiteSpace(Model.Profile.ProfileImage))
                        {
                            <div class="mb-2">
                                <img src="@Model.Profile.ProfileImage" alt="" class="rounded-circle border" width="64" height="64" style="object-fit:cover;" />
                            </div>
                        }
                        <input type="file" name="avatarFile" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                        <div class="form-text">Tuỳ chọn. JPG/PNG/GIF/WebP, tối đa 2 MB.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="EditInput_Name">Họ và tên</label>
                        <input type="text" class="form-control" id="EditInput_Name" name="EditInput.Name"
                               value="@Model.EditInput.Name" maxlength="255" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@Model.Profile.Email" disabled />
                        <div class="form-text">Email không thể thay đổi tại đây.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="EditInput_PhoneNumber">Số điện thoại</label>
                        <input type="text" class="form-control" id="EditInput_PhoneNumber" name="EditInput.PhoneNumber"
                               value="@Model.EditInput.PhoneNumber" maxlength="20" placeholder="0901234567" />
                    </div>
                    @if (!Model.IsAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_DateOfBirth">Ngày sinh</label>
                            <input type="date" class="form-control" id="EditInput_DateOfBirth" name="EditInput.DateOfBirth"
                                   value="@AccountPanelViewModel.FormatDateOnlyInput(Model.EditInput.DateOfBirth)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_Gender">Giới tính</label>
                            <select asp-for="EditInput.Gender" class="form-select" id="EditInput_Gender">
                                <option value="">— Chưa chọn —</option>
                                <option value="1">Nam</option>
                                <option value="2">Nữ</option>
                                <option value="0">Khác</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_Description">Giới thiệu</label>
                            <textarea class="form-control" id="EditInput_Description" name="EditInput.Description" rows="3">@Model.EditInput.Description</textarea>
                        </div>
                    }
                    @if (Model.IsJobSeeker)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_PermanentAddress">Địa chỉ thường trú</label>
                            <input type="text" class="form-control" id="EditInput_PermanentAddress" name="EditInput.PermanentAddress"
                                   value="@Model.EditInput.PermanentAddress" maxlength="500" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_TemporaryAddress">Địa chỉ tạm trú</label>
                            <input type="text" class="form-control" id="EditInput_TemporaryAddress" name="EditInput.TemporaryAddress"
                                   value="@Model.EditInput.TemporaryAddress" maxlength="500" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_IdCard">CMND/CCCD</label>
                            <input type="text" class="form-control" id="EditInput_IdCard" name="EditInput.IdCard"
                                   value="@Model.EditInput.IdCard" maxlength="20" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_IdCardIssueDate">Ngày cấp</label>
                            <input type="text" class="form-control" id="EditInput_IdCardIssueDate" name="EditInput.IdCardIssueDate"
                                   value="@Model.EditInput.IdCardIssueDate" maxlength="50" placeholder="VD: 01/01/2020" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_IdCardIssuePlace">Nơi cấp</label>
                            <input type="text" class="form-control" id="EditInput_IdCardIssuePlace" name="EditInput.IdCardIssuePlace"
                                   value="@Model.EditInput.IdCardIssuePlace" maxlength="255" />
                        </div>
                    }
                    @if (Model.IsEmployer)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_IdCard">CMND/CCCD</label>
                            <input type="text" class="form-control" id="EditInput_IdCard" name="EditInput.IdCard"
                                   value="@Model.EditInput.IdCard" maxlength="20" />
                        </div>
                        <p class="text-muted small mb-3">Số lượt đăng bài chỉ thay đổi khi mua gói, không chỉnh sửa tại đây.</p>
                    }
                    @if (Model.IsAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_BankName">Ngân hàng</label>
                            <input type="text" class="form-control" id="EditInput_BankName" name="EditInput.BankName"
                                   value="@Model.EditInput.BankName" maxlength="255" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="EditInput_BankAccountNumber">Số tài khoản</label>
                            <input type="text" class="form-control" id="EditInput_BankAccountNumber" name="EditInput.BankAccountNumber"
                                   value="@Model.EditInput.BankAccountNumber" maxlength="50" />
                        </div>
                    }
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </form>
            </div>

            <div class="tab-pane fade" id="account-tab-password" role="tabpanel">
                <form method="post" action="@Model.ChangePasswordFormAction">
                    <input type="hidden" name="@Model.AntiForgeryFieldName" value="@Model.AntiForgeryRequestToken" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label" for="PasswordInput_CurrentPassword">Mật khẩu hiện tại</label>
                        <input type="password" class="form-control" id="PasswordInput_CurrentPassword"
                               name="PasswordInput.CurrentPassword" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="PasswordInput_NewPassword">Mật khẩu mới</label>
                        <input type="password" class="form-control" id="PasswordInput_NewPassword"
                               name="PasswordInput.NewPassword" autocomplete="new-password" />
                        <div class="form-text">Ít nhất 8 ký tự, có chữ hoa và chữ số (theo quy tắc API).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="PasswordInput_ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                        <input type="password" class="form-control" id="PasswordInput_ConfirmNewPassword"
                               name="PasswordInput.ConfirmNewPassword" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                </form>
            </div>

            @if (Model.IsJobSeeker)
            {
                <div class="tab-pane fade" id="account-tab-resume" role="tabpanel">
                    @if (Model.Resumes.Count > 0)
                    {
                        <p class="text-muted small mb-2">Hồ sơ đã lưu</p>
                        <ul class="list-group list-group-flush border rounded mb-3 small">
                            @foreach (var r in Model.Resumes)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
                                    <div class="me-auto min-w-0">
                                        <div class="fw-semibold">@r.Title</div>
                                        <a href="@r.Url" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> Xem / tải CV (PDF)
                                        </a>
                                    </div>
                                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                        <span class="text-muted text-nowrap small">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                        <form method="post" action="@Model.DeleteResumeFormAction" class="m-0"
                                              onsubmit="return confirm('Xóa hồ sơ này? Các đơn ứng tuyển đã nộp bằng hồ sơ này cũng sẽ bị xóa. Thao tác không thể hoàn tác.');">
                                            <input type="hidden" name="@Model.AntiForgeryFieldName" value="@Model.AntiForgeryRequestToken" />
                                            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                                            <input type="hidden" name="resumeId" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">
                                                <i class="bi bi-trash me-1"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small">Bạn chưa có hồ sơ nào. Thêm tiêu đề và tải file CV dạng PDF.</p>
                    }
                    <form method="post" enctype="multipart/form-data" action="@Model.AddResumeFormAction">
                        <input type="hidden" name="@Model.AntiForgeryFieldName" value="@Model.AntiForgeryRequestToken" />
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <div class="mb-3">
                            <label class="form-label" for="ResumeInput_Title">Tiêu đề hồ sơ</label>
                            <input type="text" class="form-control" id="ResumeInput_Title" name="ResumeInput.Title"
                                   value="@Model.ResumeInput.Title" maxlength="255" required placeholder="VD: CV Frontend 2025" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ResumeFile">File CV (PDF)</label>
                            <input type="file" class="form-control" id="ResumeFile" name="resumeFile"
                                   accept="application/pdf,.pdf" required />
                            <div class="form-text">Chỉ PDF, tối đa 10 MB.</div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i> Thêm hồ sơ
                        </button>
                    </form>
                </div>
            }

            @if (Model.IsJobSeeker || Model.IsEmployer)
            {
                <div class="tab-pane fade" id="account-tab-reviews" role="tabpanel">
                    @if (Model.ReviewsPanel != null)
                    {
                        <partial name="Shared/_AccountReceivedReviewsTab" model="Model.ReviewsPanel" />
                    }
                </div>
            }
        </div>

        <div class="account-modal__footer">
            <a asp-page="/Auth/Logout" class="btn btn-outline-secondary w-100 account-modal__logout">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </a>
        </div>
            </div>
        </div>
    </div>
</div>
