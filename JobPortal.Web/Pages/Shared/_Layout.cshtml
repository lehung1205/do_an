<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobPortal.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-body">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand site-brand" asp-page="/Index">
                    <i class="bi bi-briefcase-fill me-2"></i>JobPortal
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @{
                    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("JwtToken"));
                    var userName = Context.Session.GetString("UserName");
                }
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Jobs/Index">Việc làm</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2 nav-auth">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item nav-auth__greeting d-none d-lg-block">
                                <span class="text-muted small">Xin chào, <strong>@userName</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm px-3" asp-page="/Auth/Logout">Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm px-3" asp-page="/Auth/Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-page="/Auth/Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <a class="site-brand text-white text-decoration-none" asp-page="/Index">
                        <i class="bi bi-briefcase-fill me-2"></i>JobPortal
                    </a>
                    <p class="small text-white-50 mt-2 mb-0">Nền tảng kết nối ứng viên và nhà tuyển dụng.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a class="text-white-50 small text-decoration-none me-3" asp-page="/Privacy">Chính sách</a>
                    <span class="text-white-50 small">&copy; @DateTime.Now.Year JobPortal</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
