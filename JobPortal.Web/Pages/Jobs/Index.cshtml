@page
@model JobPortal.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Việc làm";
}

<div class="container py-4">
    <h2 class="mb-4">Danh sách việc làm</h2>

    @if (Model.Jobs.Count == 0)
    {
        <p class="text-muted">Chưa có tin tuyển dụng nào.</p>
    }
    else
    {
        @foreach (var job in Model.Jobs)
        {
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="mb-1">@job.Title</h5>
                    <p class="text-muted mb-2">
                        <i class="bi bi-geo-alt me-1"></i>@job.Location
                        <span class="mx-2">·</span>
                        <i class="bi bi-cash-stack me-1"></i>@job.Salary.ToString("N0") VNĐ
                    </p>
                    <a asp-page="/Jobs/Detail" asp-route-id="@job.Id"
                       class="btn btn-primary btn-sm">Xem chi tiết</a>
                </div>
            </div>
        }
    }
</div>
