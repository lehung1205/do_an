@page
@model JobPortal.Web.Pages.Employer.BuyPackagesModel
@{
    ViewData["Title"] = "Mua gói";
}

<div class="container py-4">
    <h2 class="mb-2"><i class="bi bi-bag-heart me-2"></i>Mua gói đăng tin</h2>
    <p class="text-muted mb-4">Chọn gói phù hợp để tăng hạn mức đăng bài. Thanh toán có thể được tích hợp ở bước sau.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (Model.Packages.Count > 0)
    {
        <div class="row g-4">
            @foreach (var p in Model.Packages)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="text-muted small mb-2">Số tin đăng: <strong>@p.PostingLimit</strong></p>
                            <p class="h5 text-primary mb-3">@p.Price.ToString("N0") <span class="fs-6 fw-normal">VNĐ</span></p>
                            <button type="button" class="btn btn-outline-primary mt-auto" disabled title="Tích hợp thanh toán sau">
                                Chọn gói (demo)
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p class="small text-muted mt-4 mb-0">Nút mua sẽ kết nối cổng thanh toán khi bạn triển khai phần thanh toán.</p>
    }
</div>
