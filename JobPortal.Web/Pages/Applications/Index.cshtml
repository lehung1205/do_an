@page
@model JobPortal.Web.Pages.Applications.IndexModel
@{
    ViewData["Title"] = "Đơn ứng tuyển của tôi";
}

<div class="container mt-5 mb-5">
    <h1 class="h3 mb-4">Đơn ứng tuyển của tôi</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Applications.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            <p class="mb-3 text-muted">Bạn chưa ứng tuyển việc làm nào.</p>
            <a asp-page="/Jobs/Index" class="btn app-action-btn app-action-btn--primary">
                <i class="bi bi-briefcase me-1"></i>Xem việc làm
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Việc làm</th>
                        <th>Địa điểm</th>
                        <th>Lương (VNĐ)</th>
                        <th>Hồ sơ</th>
                        <th>Ngày nộp</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Applications)
                    {
                        <tr>
                            <td class="fw-semibold">@app.JobTitle</td>
                            <td>@app.JobLocation</td>
                            <td>@app.JobSalary</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(app.ResumeUrl))
                                {
                                    <a href="@app.ResumeUrl" target="_blank" rel="noopener noreferrer">@app.ResumeTitle</a>
                                }
                                else
                                {
                                    @app.ResumeTitle
                                }
                            </td>
                            <td>@app.AppliedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @IndexModel.StatusBadgeClass(app.Status)">@IndexModel.FormatStatus(app.Status)</span></td>
                            <td class="text-nowrap app-action-group">
                                <a asp-page="/Messages/Index" asp-route-applicationId="@app.Id"
                                   class="btn btn-sm app-action-btn app-action-btn--muted">Nhắn tin</a>
                                <a asp-page="/Jobs/Detail" asp-route-id="@app.JobId" class="btn btn-sm app-action-btn app-action-btn--info">Xem tin</a>
                                @if (string.Equals(app.Status, "accepted", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a asp-page="/Applications/WorkProgress/Detail" asp-route-applicationId="@app.Id"
                                       class="btn btn-sm app-action-btn app-action-btn--primary">Tiến độ</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <style>
        .app-action-group {
            display: flex;
            justify-content: flex-end;
            gap: 0.4rem;
            flex-wrap: wrap;
        }

        .app-action-btn {
            border-radius: 10px;
            font-weight: 600;
            border: 1px solid transparent;
            transition: all 0.16s ease;
        }

        .app-action-btn--primary {
            background: var(--jp-primary, #0000ee);
            border-color: var(--jp-primary, #0000ee);
            color: #fff;
        }

        .app-action-btn--primary:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #fff;
            transform: translateY(-1px);
        }

        .app-action-btn--muted {
            background: #f8fafc;
            border-color: #dbe3ef;
            color: #475569;
        }

        .app-action-btn--muted:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
            color: #334155;
        }

        .app-action-btn--info {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
        }

        .app-action-btn--info:hover {
            background: #dbeafe;
            border-color: #93c5fd;
            color: #1e40af;
        }
    </style>
}
