@page
@model JobPortal.Web.Pages.Employer.PaymentHistory.IndexModel
@using JobPortal.Web.Models
@using JobPortal.Web.Helpers
@{
    ViewData["Title"] = "Lịch sử thanh toán";
    ViewData["EmployerNavActive"] = EmployerPortalNavKeys.PaymentHistory;
    var routeStatus = Model.StatusFilter;
}

<partial name="Shared/_EmployerPageHeader" model='new EmployerPageHeaderModel {
    Title = "Lịch sử thanh toán",
    Subtitle = "Theo dõi các giao dịch mua gói đăng tin qua VNPay",
    CtaText = "Mua gói mới",
    CtaPage = "/Employer/BuyPackages",
    CtaIconClass = "bi-bag-heart"
}' />

<div class="employer-dash__panel-stack emp-pay-history">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="emp-pay-history__stats">
            <div class="emp-pay-history__stat">
                <span class="emp-pay-history__stat-label">Tổng đã thanh toán</span>
                <span class="emp-pay-history__stat-value">@IndexModel.FormatMoney(Model.Summary.TotalPaidAmount)</span>
                <span class="emp-pay-history__stat-meta">@Model.Summary.PaidCount giao dịch thành công</span>
            </div>
            <div class="emp-pay-history__stat">
                <span class="emp-pay-history__stat-label">Lượt đăng còn lại</span>
                <span class="emp-pay-history__stat-value emp-pay-history__stat-value--accent">@Model.Summary.CurrentPostingLimit</span>
                <span class="emp-pay-history__stat-meta">Có thể dùng để đăng tin</span>
            </div>
            <div class="emp-pay-history__stat">
                <span class="emp-pay-history__stat-label">Đang chờ</span>
                <span class="emp-pay-history__stat-value">@Model.Summary.PendingCount</span>
                <span class="emp-pay-history__stat-meta">Chưa hoàn tất thanh toán</span>
            </div>
            <div class="emp-pay-history__stat">
                <span class="emp-pay-history__stat-label">Thất bại</span>
                <span class="emp-pay-history__stat-value">@Model.Summary.FailedCount</span>
                <span class="emp-pay-history__stat-meta">Tổng @Model.Summary.TotalCount giao dịch</span>
            </div>
        </div>

        <form method="get" class="emp-apps-filter">
            <div class="emp-apps-filter__grid emp-apps-filter__grid--pay">
                <div class="emp-apps-filter__field">
                    <label class="form-label" for="status">Trạng thái</label>
                    <select class="form-select" id="status" name="status">
                        @if (routeStatus == "all")
                        {
                            <option value="all" selected>Tất cả</option>
                        }
                        else
                        {
                            <option value="all">Tất cả</option>
                        }
                        @if (routeStatus == "paid")
                        {
                            <option value="paid" selected>Đã thanh toán</option>
                        }
                        else
                        {
                            <option value="paid">Đã thanh toán</option>
                        }
                        @if (routeStatus == "pending")
                        {
                            <option value="pending" selected>Đang chờ</option>
                        }
                        else
                        {
                            <option value="pending">Đang chờ</option>
                        }
                        @if (routeStatus == "failed")
                        {
                            <option value="failed" selected>Thất bại</option>
                        }
                        else
                        {
                            <option value="failed">Thất bại</option>
                        }
                    </select>
                </div>
                <div class="emp-apps-filter__field">
                    <label class="form-label" for="q">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search" class="form-control border-start-0" id="q" name="q" value="@Model.Search"
                               placeholder="Mã đơn, tên gói, mã giao dịch..." maxlength="200" />
                    </div>
                </div>
                <div class="emp-apps-filter__field emp-apps-filter__field--actions">
                    <label class="form-label emp-apps-filter__label-spacer" aria-hidden="true">&nbsp;</label>
                    <div class="emp-apps-filter__actions">
                        <button type="submit" class="btn emp-apps-btn emp-apps-btn--primary emp-apps-btn--filter w-100">
                            <i class="bi bi-search me-1"></i>Tìm
                        </button>
                        @if (Model.HasActiveFilter)
                        {
                            <a asp-page="/Employer/PaymentHistory/Index" class="btn emp-apps-btn emp-apps-btn--muted emp-apps-btn--filter w-100" title="Xóa bộ lọc">
                                <i class="bi bi-x-lg me-1"></i>Xóa lọc
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="employer-panel emp-pay-history__empty text-center py-5">
                <div class="emp-pay-history__empty-icon mb-3" aria-hidden="true">
                    <i class="bi bi-receipt"></i>
                </div>
                <h2 class="h6 mb-2">Chưa có giao dịch nào</h2>
                <p class="text-muted small mb-4">
                    @(Model.Summary.TotalCount == 0
                        ? "Khi bạn mua gói đăng tin, lịch sử thanh toán sẽ hiển thị tại đây."
                        : "Không có giao dịch khớp bộ lọc hiện tại.")
                </p>
                <a asp-page="/Employer/BuyPackages" class="btn emp-apps-btn emp-apps-btn--primary">
                    <i class="bi bi-bag-heart me-1"></i> Mua gói đăng tin
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.Items)
                {
                    <article class="employer-panel emp-pay-card">
                        <div class="emp-pay-card__head">
                            <div class="min-w-0">
                                <h3 class="emp-pay-card__title">@item.PackageName</h3>
                                <p class="emp-pay-card__meta mb-0">
                                    @if (item.PostingLimitSnapshot is int limit and > 0)
                                    {
                                        <span><i class="bi bi-megaphone me-1"></i>+@limit lượt đăng</span>
                                        <span class="mx-2">·</span>
                                    }
                                    <span><i class="bi bi-hash me-1"></i>@item.OrderId</span>
                                </p>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <div class="emp-pay-card__amount">@IndexModel.FormatMoney(item.Amount)</div>
                                <span class="@PaymentStatusHelper.BadgeClass(item.Status)">
                                    @PaymentStatusHelper.FormatStatus(item.Status)
                                </span>
                            </div>
                        </div>
                        <dl class="emp-pay-card__details">
                            <div>
                                <dt>Thời gian</dt>
                                <dd>@IndexModel.FormatDateTime(item.PaymentDate ?? item.CreatedAt)</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.PaymentProvider))
                            {
                                <div>
                                    <dt>Cổng thanh toán</dt>
                                    <dd>@item.PaymentProvider</dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.PaymentBank))
                            {
                                <div>
                                    <dt>Ngân hàng</dt>
                                    <dd>@item.PaymentBank</dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ProviderTransactionId))
                            {
                                <div>
                                    <dt>Mã GD VNPay</dt>
                                    <dd class="font-monospace small">@item.ProviderTransactionId</dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.TransactionCode))
                            {
                                <div>
                                    <dt>Mã tham chiếu</dt>
                                    <dd class="font-monospace small">@item.TransactionCode</dd>
                                </div>
                            }
                        </dl>
                    </article>
                }
            </div>

            @if (Model.ShowPagination)
            {
                <nav class="mt-4" aria-label="Phân trang lịch sử thanh toán">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Employer/PaymentHistory/Index"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-status="@(routeStatus == "all" ? null : routeStatus)"
                               asp-route-q="@Model.Search">
                                Trước
                            </a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Employer/PaymentHistory/Index"
                                   asp-route-pageNumber="@p"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-status="@(routeStatus == "all" ? null : routeStatus)"
                                   asp-route-q="@Model.Search">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Employer/PaymentHistory/Index"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-status="@(routeStatus == "all" ? null : routeStatus)"
                               asp-route-q="@Model.Search">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/employer-applicants.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employer-payment-history.css" asp-append-version="true" />
}
