@page "{id:long}"
@model JobPortal.Web.Pages.Jobs.DetailModel
@{
    ViewData["Title"] = Model.Job.Title;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Jobs/Index">Việc làm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="h2 mb-1">@Model.Job.Title</h1>
                            <p class="text-primary h5 mb-0">Nhà tuyển dụng #@Model.Job.EmployerId</p>
                        </div>
                        <span class="badge @DetailModel.StatusBadgeClass(Model.Job.PostingStatus) p-2">
                            @DetailModel.FormatPostingStatus(Model.Job.PostingStatus)
                        </span>
                    </div>

                    @if (Model.IsClosed && Model.IsEmployerViewer)
                    {
                        <div class="alert alert-secondary">
                            Tin đã hết hạn và được đóng tự động. Bạn vẫn xem được nội dung chi tiết; ứng viên không thể nộp hồ sơ mới.
                        </div>
                    }
                    else if (Model.IsClosed)
                    {
                        <div class="alert alert-warning">
                            Tin tuyển dụng đã đóng, không nhận hồ sơ ứng tuyển mới.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-3 mb-4 text-muted">
                        <span><i class="bi bi-geo-alt"></i> @Model.Job.Location</span>
                        <span><i class="bi bi-currency-dollar"></i> @Model.Job.Salary</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Job.WorkingHours))
                        {
                            <span><i class="bi bi-clock"></i> @Model.Job.WorkingHours</span>
                        }
                    </div>

                    <hr />

                    <div class="job-description mt-4">
                        <h4 class="mb-3">Mô tả công việc</h4>
                        <div style="white-space: pre-wrap;">@Model.Job.Description</div>
                    </div>

                    @if (Model.JobImages.Count > 0)
                    {
                        <div class="mt-4">
                            <h4 class="mb-3">Hình ảnh</h4>
                            <div class="row g-2">
                                @foreach (var img in Model.JobImages)
                                {
                                    <div class="col-6 col-md-4">
                                        <a href="@img.Url" target="_blank" rel="noopener noreferrer" class="d-block border rounded overflow-hidden">
                                            <img src="@img.Url" alt="@(img.Name ?? "Ảnh tin")" class="img-fluid w-100 object-fit-cover" style="aspect-ratio:4/3;max-height:200px;" loading="lazy" />
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ApplySuccessMessage))
                    {
                        <div class="alert alert-success mt-4">@Model.ApplySuccessMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ApplyErrorMessage))
                    {
                        <div class="alert alert-danger mt-4">@Model.ApplyErrorMessage</div>
                    }

                    @if (Model.ShowApplyButton)
                    {
                        <div class="mt-5">
                            @if (Model.HasApplied)
                            {
                                <span class="badge bg-success fs-6 px-4 py-2">
                                    <i class="bi bi-check-circle me-1"></i> Đã ứng tuyển
                                </span>
                                <a asp-page="/Applications/Index" class="btn btn-outline-primary ms-2">Xem đơn của tôi</a>
                            }
                            else if (!Model.IsRecruiting)
                            {
                                <p class="text-muted mb-0">
                                    @(Model.IsClosed ? "Tin tuyển dụng đã đóng, không nhận hồ sơ mới." : "Tin tuyển dụng hiện không nhận hồ sơ.")
                                </p>
                            }
                            else if (!Model.IsLoggedIn)
                            {
                                <a asp-page="/Auth/Login"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="btn btn-primary btn-lg px-5">
                                    Đăng nhập để ứng tuyển
                                </a>
                            }
                            else if (!Model.IsJobSeeker)
                            {
                                <p class="text-muted mb-0">Chỉ tài khoản ứng viên mới có thể ứng tuyển.</p>
                            }
                            else if (Model.Resumes.Count == 0)
                            {
                                <p class="text-muted">Bạn cần thêm ít nhất một hồ sơ (CV) trước khi ứng tuyển.</p>
                                <a asp-page="/Index"
                                   asp-route-openAccount="true"
                                   asp-route-accountTab="resume"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="btn btn-primary btn-lg mt-2">
                                    Thêm hồ sơ (CV)
                                </a>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Apply" asp-route-id="@Model.Job.Id" class="apply-form">
                                    @if (Model.Resumes.Count > 1)
                                    {
                                        <div class="mb-3" style="max-width: 400px;">
                                            <label class="form-label fw-semibold" for="SelectedResumeId">Chọn hồ sơ (CV)</label>
                                            <select asp-for="SelectedResumeId" id="SelectedResumeId" class="form-select form-select-lg" required>
                                                <option value="">-- Chọn CV --</option>
                                                @foreach (var cv in Model.Resumes)
                                                {
                                                    <option value="@cv.Id">@cv.Title</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="hidden" asp-for="SelectedResumeId" />
                                        <p class="text-muted small mb-2">
                                            Hồ sơ: <strong>@Model.Resumes[0].Title</strong>
                                        </p>
                                    }
                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        <i class="bi bi-send me-1"></i> Ứng tuyển ngay
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title mb-3">Thông tin tóm tắt</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><strong>Mức lương:</strong> @Model.Job.Salary</li>
                        <li class="mb-2"><strong>Mã nhà tuyển dụng:</strong> @Model.Job.EmployerId</li>
                        <li class="mb-2"><strong>Địa điểm:</strong> @Model.Job.Location</li>
                        <li class="mb-2"><strong>Thời gian làm việc:</strong> @(string.IsNullOrWhiteSpace(Model.Job.WorkingHours) ? "—" : Model.Job.WorkingHours)</li>
                        <li class="mb-2"><strong>Hết hạn tin:</strong> @Model.Job.ExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .job-description {
        line-height: 1.7;
        color: #444;
    }
    .breadcrumb-item a {
        text-decoration: none;
    }
</style>
