@page
@model JobPortal.Web.Pages.Jobs.IndexModel

<h2>Danh sách việc làm</h2>

@foreach (var job in Model.Jobs)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5>@job.tieu_de</h5>
            <p>@job.dia_diem — Mã NTD: @job.id_tuyen_dung</p>
            <a asp-page="/Jobs/Detail" asp-route-id="@job.id_cong_viec"
               class="btn btn-primary">Xem chi tiết</a>
        </div>
    </div>
}
