@page
@model JobPortal.Web.Pages.Employer.JobsModel
@{
    ViewData["Title"] = "Tin tuyển dụng";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-briefcase me-2"></i>Tin tuyển dụng</h2>
            <p class="text-muted mb-0">Quản lý các tin đã đăng của công ty bạn</p>
        </div>
        <a asp-page="/Employer/PostJob" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Đăng tin mới
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ActionErrorMessage))
    {
        <div class="alert alert-warning">@Model.ActionErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    @if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <form method="get" class="employer-panel mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="status">Trạng thái</label>
                    <select class="form-select" id="status" name="status">
                        @if (Model.StatusFilter == null)
                        {
                            <option value="all" selected>Tất cả</option>
                        }
                        else
                        {
                            <option value="all">Tất cả</option>
                        }
                        @if (Model.StatusFilter == "pending")
                        {
                            <option value="pending" selected>Chờ duyệt</option>
                        }
                        else
                        {
                            <option value="pending">Chờ duyệt</option>
                        }
                        @if (Model.StatusFilter == "recruiting")
                        {
                            <option value="recruiting" selected>Đang tuyển</option>
                        }
                        else
                        {
                            <option value="recruiting">Đang tuyển</option>
                        }
                        @if (Model.StatusFilter == "rejected")
                        {
                            <option value="rejected" selected>Từ chối</option>
                        }
                        else
                        {
                            <option value="rejected">Từ chối</option>
                        }
                        @if (Model.StatusFilter == "closed")
                        {
                            <option value="closed" selected>Đã đóng</option>
                        }
                        else
                        {
                            <option value="closed">Đã đóng</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="q">Tìm kiếm</label>
                    <input type="search" class="form-control" id="q" name="q" value="@Model.Search"
                           placeholder="Tiêu đề, mô tả, địa điểm, lương..." maxlength="200" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Lọc
                    </button>
                    <a asp-page="/Employer/Jobs" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </form>

        @if (Model.Jobs.Count == 0)
        {
            <div class="employer-panel text-center py-5 text-muted">
                @if (Model.HasActiveFilter)
                {
                    <i class="bi bi-funnel display-6 d-block mb-2"></i>
                    <p class="mb-2">Không có tin phù hợp bộ lọc.</p>
                    <a asp-page="/Employer/Jobs" class="btn btn-sm btn-outline-primary">Xóa bộ lọc</a>
                }
                else
                {
                    <text>Chưa có tin nào. <a asp-page="/Employer/PostJob">Đăng tin đầu tiên</a></text>
                }
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 g-lg-4 job-grid">
                @foreach (var job in Model.Jobs)
                {
                    <div class="col d-flex">
                        <partial name="Shared/_JobGridCard" model="JobPortal.Web.Models.JobGridCardModel.FromEmployerManageJob(job, Model.StatusFilter, Model.Search, Model.CurrentPage, Model.PageSize)" />
                    </div>
                }
            </div>

            @if (Model.ShowPagination)
            {
                <nav class="mt-4" aria-label="Phân trang tin tuyển dụng">
                    <ul class="pagination justify-content-center flex-wrap mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Employer/Jobs"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-q="@Model.Search"
                               aria-label="Trang trước">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Employer/Jobs"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-q="@Model.Search">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Employer/Jobs"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-q="@Model.Search"
                               aria-label="Trang sau">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-muted small text-center mt-2 mb-0">
                        Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount tin
                    </p>
                </nav>
            }
            else if (Model.TotalCount > 0)
            {
                <p class="text-muted small text-center mt-3 mb-0">@Model.TotalCount tin</p>
            }
        }
    }
</div>
