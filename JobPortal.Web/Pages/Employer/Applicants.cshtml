@page
@model JobPortal.Web.Pages.Employer.ApplicantsModel
@using static JobPortal.Web.Pages.Employer.ApplicantsModel
@using JobPortal.Web.Models
@{
    ViewData["Title"] = "Ứng viên ứng tuyển";
    ViewData["EmployerNavActive"] = EmployerPortalNavKeys.Applicants;
    var total = Model.AllApplicants.Count;
}

<div class="emp-apps">
    <header class="emp-apps-hero">
        <div class="emp-apps-hero__text">
            <p class="emp-apps-hero__eyebrow">
                <i class="bi bi-people"></i> Tuyển dụng
            </p>
            <h1 class="emp-apps-hero__title">Ứng viên ứng tuyển</h1>
            <p class="emp-apps-hero__subtitle">
                Xem hồ sơ, đánh giá sao, duyệt CV và cập nhật trạng thái từng đơn — theo dõi tiến độ sau khi chấp nhận.
            </p>
        </div>
        @if (total > 0)
        {
            <div class="emp-apps-hero__stats">
                <div class="emp-apps-hero__pill" aria-label="Tổng đơn">
                    <span class="emp-apps-hero__pill-value">@total</span>
                    <span class="emp-apps-hero__pill-label">Tổng CV</span>
                </div>
                @if (Model.UnreadCount > 0)
                {
                    <div class="emp-apps-hero__pill" aria-label="Chưa xem">
                        <span class="emp-apps-hero__pill-value emp-apps-hero__pill-value--warn">@Model.UnreadCount</span>
                        <span class="emp-apps-hero__pill-label">Chưa xem</span>
                    </div>
                }
            </div>
        }
    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success emp-apps-alert shadow-sm">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning emp-apps-alert shadow-sm">@Model.ErrorMessage</div>
    }

    @if (total == 0)
    {
        <div class="emp-apps-empty">
            <div class="emp-apps-empty__icon" aria-hidden="true">
                <i class="bi bi-inbox"></i>
            </div>
            <h2 class="h5 mb-2">Chưa có ứng viên</h2>
            <p class="text-muted mb-4">Khi có người ứng tuyển vào tin của bạn, danh sách sẽ hiển thị tại đây.</p>
            <a asp-page="/Employer/Jobs" class="btn emp-apps-btn emp-apps-btn--primary">
                <i class="bi bi-briefcase me-1"></i>Quản lý tin tuyển dụng
            </a>
        </div>
    }
    else
    {
        <nav class="emp-apps-stats" aria-label="Lọc theo trạng thái">
            <a asp-page="/Employer/Applicants"
               asp-route-filter="all"
               asp-route-q="@Model.Search"
               class="emp-apps-stat @(Model.Filter == "all" ? "is-active" : "")">
                <span class="emp-apps-stat__label">Tất cả</span>
                <span class="emp-apps-stat__value">@total</span>
            </a>
            <a asp-page="/Employer/Applicants"
               asp-route-filter="pending_response"
               asp-route-q="@Model.Search"
               class="emp-apps-stat emp-apps-stat--pending @(Model.Filter == "pending_response" ? "is-active" : "")">
                <span class="emp-apps-stat__label">Chưa phản hồi</span>
                <span class="emp-apps-stat__value">@Model.PendingResponseCount</span>
            </a>
            <a asp-page="/Employer/Applicants"
               asp-route-filter="accepted"
               asp-route-q="@Model.Search"
               class="emp-apps-stat emp-apps-stat--accepted @(Model.Filter == "accepted" ? "is-active" : "")">
                <span class="emp-apps-stat__label">Đã chấp nhận</span>
                <span class="emp-apps-stat__value">@Model.AcceptedCount</span>
            </a>
            <a asp-page="/Employer/Applicants"
               asp-route-filter="rejected"
               asp-route-q="@Model.Search"
               class="emp-apps-stat emp-apps-stat--rejected @(Model.Filter == "rejected" ? "is-active" : "")">
                <span class="emp-apps-stat__label">Đã từ chối</span>
                <span class="emp-apps-stat__value">@Model.RejectedCount</span>
            </a>
        </nav>

        <form method="get" class="emp-apps-filter">
            <div class="emp-apps-filter__grid">
                <div class="emp-apps-filter__field">
                    <label class="form-label" for="filter">Trạng thái</label>
                    <select class="form-select" id="filter" name="filter">
                        @if (Model.Filter == "all")
                        {
                            <option value="all" selected>Tất cả</option>
                        }
                        else
                        {
                            <option value="all">Tất cả</option>
                        }
                        @if (Model.Filter == "pending_response")
                        {
                            <option value="pending_response" selected>Chưa phản hồi</option>
                        }
                        else
                        {
                            <option value="pending_response">Chưa phản hồi</option>
                        }
                        @if (Model.Filter == "accepted")
                        {
                            <option value="accepted" selected>Đã chấp nhận</option>
                        }
                        else
                        {
                            <option value="accepted">Đã chấp nhận</option>
                        }
                        @if (Model.Filter == "rejected")
                        {
                            <option value="rejected" selected>Đã từ chối</option>
                        }
                        else
                        {
                            <option value="rejected">Đã từ chối</option>
                        }
                    </select>
                </div>
                <div class="emp-apps-filter__field">
                    <label class="form-label" for="q">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="q" name="q" type="search" class="form-control border-start-0"
                               value="@Model.Search"
                               placeholder="Tên ứng viên, việc làm, CV, email..." />
                    </div>
                </div>
                <div class="emp-apps-filter__field emp-apps-filter__field--actions">
                    <label class="form-label emp-apps-filter__label-spacer" aria-hidden="true">&nbsp;</label>
                    <div class="emp-apps-filter__actions">
                        <button type="submit" class="btn emp-apps-btn emp-apps-btn--primary emp-apps-btn--filter w-100">
                            <i class="bi bi-funnel me-1"></i>Lọc
                        </button>
                        @if (Model.HasActiveFilter)
                        {
                            <a asp-page="/Employer/Applicants" class="btn emp-apps-btn emp-apps-btn--muted emp-apps-btn--filter w-100">
                                <i class="bi bi-x-lg me-1"></i>Xóa lọc
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>

        <p class="emp-apps-toolbar">
            Hiển thị <strong>@Model.FilteredApplicants.Count</strong> / @total ứng viên
        </p>

        @if (Model.FilteredApplicants.Count == 0)
        {
            <div class="emp-apps-empty emp-apps-empty--compact">
                <i class="bi bi-funnel display-6 text-muted mb-2 d-block"></i>
                <p class="mb-3 text-muted">Không có ứng viên phù hợp bộ lọc.</p>
                <a asp-page="/Employer/Applicants" class="btn btn-sm emp-apps-btn emp-apps-btn--info">Xem tất cả</a>
            </div>
        }
        else
        {
            <div class="emp-apps-list">
                @foreach (var app in Model.FilteredApplicants)
                {
                    var statusKey = app.Status.Trim().ToLowerInvariant();
                    var isFinalAccepted = statusKey == "accepted";
                    var isFinalRejected = statusKey == "rejected";
                    var isJobClosed = string.Equals(app.JobPostingStatus, "closed", StringComparison.OrdinalIgnoreCase);
                    var hint = StatusHint(app.Status, app.IsUnread);

                    <article class="emp-app-card @StatusCardModifier(app.Status) @(app.IsUnread ? "emp-app-card--new" : "")">
                        <div class="emp-app-card__aside">
                            <button type="button"
                                    class="emp-app-card__avatar-btn applicant-profile-trigger"
                                    data-application-id="@app.Id"
                                    title="Xem hồ sơ @app.ApplicantName"
                                    aria-label="Xem hồ sơ @app.ApplicantName">
                                <span class="emp-app-card__avatar" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(app.ApplicantProfileImage))
                                    {
                                        <img src="@app.ApplicantProfileImage" alt="" class="emp-app-card__avatar-img" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill"></i>
                                    }
                                </span>
                                <span class="emp-app-card__profile-link">Xem hồ sơ</span>
                            </button>
                        </div>

                        <div class="emp-app-card__body">
                            <div class="emp-app-card__head">
                                <div>
                                    <h2 class="emp-app-card__name">
                                        @app.ApplicantName
                                        @if (app.IsUnread)
                                        {
                                            <span class="emp-app-card__badge-new">Mới</span>
                                        }
                                    </h2>
                                    <partial name="Shared/_ApplicantRatingStars"
                                             model="ApplicantRatingStarsModel.FromApplication(app)" />
                                    @if (!string.IsNullOrWhiteSpace(app.ApplicantEmail) || !string.IsNullOrWhiteSpace(app.ApplicantPhone))
                                    {
                                        <ul class="emp-app-card__contact">
                                            @if (!string.IsNullOrWhiteSpace(app.ApplicantEmail))
                                            {
                                                <li><i class="bi bi-envelope"></i>@app.ApplicantEmail</li>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(app.ApplicantPhone))
                                            {
                                                <li><i class="bi bi-telephone"></i>@app.ApplicantPhone</li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <span class="emp-app-card__status">@FormatStatus(app.Status)</span>
                            </div>

                            <div class="emp-app-card__job">
                                <div class="emp-app-card__job-thumb" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(app.JobThumbnailUrl))
                                    {
                                        <img src="@app.JobThumbnailUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-briefcase"></i>
                                    }
                                </div>
                                <div>
                                    <h3 class="emp-app-card__job-title">
                                        <a asp-page="/Jobs/Detail" asp-route-id="@app.JobId">@app.JobTitle</a>
                                    </h3>
                                    <p class="emp-app-card__job-meta mb-0">
                                        @if (!string.IsNullOrWhiteSpace(app.CategoryName))
                                        {
                                            <i class="bi bi-tag"></i> @app.CategoryName
                                            <span class="mx-1">·</span>
                                        }
                                        <i class="bi bi-geo-alt"></i> @app.JobLocation
                                    </p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(hint))
                            {
                                <p class="emp-app-card__hint">
                                    <i class="bi bi-lightbulb"></i> @hint
                                </p>
                            }

                            <ul class="emp-app-card__facts">
                                <li>
                                    <i class="bi bi-cash-stack"></i>
                                    <span>@app.JobSalary</span>
                                </li>
                                @if (!string.IsNullOrWhiteSpace(app.JobWorkingHours))
                                {
                                    <li>
                                        <i class="bi bi-clock"></i>
                                        <span>@app.JobWorkingHours</span>
                                    </li>
                                }
                                <li>
                                    <i class="bi bi-calendar-event"></i>
                                    <span>Hết hạn tin @app.JobExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </li>
                                <li>
                                    <i class="bi bi-send"></i>
                                    <span>Ứng tuyển @FormatRelativeTime(app.AppliedAt)</span>
                                </li>
                            </ul>

                            <div class="emp-app-card__chips">
                                @if (isJobClosed)
                                {
                                    <span class="emp-app-chip emp-app-chip--muted">
                                        <i class="bi bi-lock"></i> @FormatJobPostingStatus(app.JobPostingStatus)
                                    </span>
                                }
                                else
                                {
                                    <span class="emp-app-chip emp-app-chip--open">
                                        <i class="bi bi-broadcast"></i> @FormatJobPostingStatus(app.JobPostingStatus)
                                    </span>
                                }
                                <span class="emp-app-chip emp-app-chip--resume">
                                    <i class="bi bi-file-earmark-person"></i>
                                    @app.ResumeTitle
                                </span>
                                <span class="emp-app-chip">#@app.Id</span>
                            </div>
                        </div>

                        <footer class="emp-app-card__footer">
                            @if (!string.IsNullOrWhiteSpace(app.ResumeUrl))
                            {
                                <a asp-page="/Employer/Applicants"
                                   asp-page-handler="ViewCv"
                                   asp-route-applicationId="@app.Id"
                                   asp-route-filter="@Model.Filter"
                                   asp-route-q="@Model.Search"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-sm emp-apps-btn emp-apps-btn--muted">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>Xem CV
                                </a>
                            }

                            <button type="button"
                                    class="btn btn-sm emp-apps-btn emp-apps-btn--muted applicant-profile-trigger"
                                    data-application-id="@app.Id">
                                <i class="bi bi-person-lines-fill me-1"></i>Hồ sơ
                            </button>

                            <a asp-page="/Messages/Index" asp-route-applicationId="@app.Id"
                               class="btn btn-sm emp-apps-btn emp-apps-btn--info">
                                <i class="bi bi-chat-dots me-1"></i>Nhắn tin
                            </a>

                            @if (isFinalAccepted)
                            {
                                <a asp-page="/Employer/WorkProgress/Detail"
                                   asp-route-applicationId="@app.Id"
                                   class="btn btn-sm emp-apps-btn emp-apps-btn--primary">
                                    <i class="bi bi-clipboard-check me-1"></i>Quản lý tiến độ
                                </a>
                                <a asp-page="/Jobs/Detail"
                                   asp-route-id="@app.JobId"
                                   class="btn btn-sm emp-apps-btn emp-apps-btn--muted">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem tin
                                </a>
                            }
                            else if (isFinalRejected)
                            {
                                <a asp-page="/Jobs/Detail"
                                   asp-route-id="@app.JobId"
                                   class="btn btn-sm emp-apps-btn emp-apps-btn--muted">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem tin
                                </a>
                            }
                            else
                            {
                                @if (app.IsUnread)
                                {
                                    <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                        <input type="hidden" name="applicationId" value="@app.Id" />
                                        <input type="hidden" name="status" value="reviewed" />
                                        <input type="hidden" name="filter" value="@Model.Filter" />
                                        <input type="hidden" name="q" value="@Model.Search" />
                                        <button type="submit" class="btn btn-sm emp-apps-btn emp-apps-btn--muted">
                                            <i class="bi bi-check2-circle me-1"></i>Đã xem
                                        </button>
                                    </form>
                                }

                                <form method="post" asp-page-handler="UpdateStatus" class="d-inline"
                                      id="emp-moderate-form-accept-@app.Id">
                                    <input type="hidden" name="applicationId" value="@app.Id" />
                                    <input type="hidden" name="status" value="accepted" />
                                    <input type="hidden" name="filter" value="@Model.Filter" />
                                    <input type="hidden" name="q" value="@Model.Search" />
                                    <button type="submit" class="d-none" tabindex="-1" aria-hidden="true">Submit</button>
                                    <button type="button"
                                            class="btn btn-sm emp-apps-btn emp-apps-btn--success js-emp-app-moderate"
                                            data-bs-toggle="modal"
                                            data-bs-target="#empAppModerateModal"
                                            data-moderate-action="accept"
                                            data-moderate-form="emp-moderate-form-accept-@app.Id"
                                            data-applicant-name="@app.ApplicantName"
                                            data-job-title="@app.JobTitle">
                                        <i class="bi bi-check-lg me-1"></i>Chấp nhận
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="UpdateStatus" class="d-inline"
                                      id="emp-moderate-form-reject-@app.Id">
                                    <input type="hidden" name="applicationId" value="@app.Id" />
                                    <input type="hidden" name="status" value="rejected" />
                                    <input type="hidden" name="filter" value="@Model.Filter" />
                                    <input type="hidden" name="q" value="@Model.Search" />
                                    <button type="submit" class="d-none" tabindex="-1" aria-hidden="true">Submit</button>
                                    <button type="button"
                                            class="btn btn-sm emp-apps-btn emp-apps-btn--danger js-emp-app-moderate"
                                            data-bs-toggle="modal"
                                            data-bs-target="#empAppModerateModal"
                                            data-moderate-action="reject"
                                            data-moderate-form="emp-moderate-form-reject-@app.Id"
                                            data-applicant-name="@app.ApplicantName"
                                            data-job-title="@app.JobTitle">
                                        <i class="bi bi-x-lg me-1"></i>Từ chối
                                    </button>
                                </form>
                                <a asp-page="/Jobs/Detail"
                                   asp-route-id="@app.JobId"
                                   class="btn btn-sm emp-apps-btn emp-apps-btn--muted">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem tin
                                </a>
                            }
                        </footer>
                    </article>
                }
            </div>
        }
    }
</div>

<div class="modal fade emp-app-moderate-modal" id="empAppModerateModal" tabindex="-1"
     aria-labelledby="empAppModerateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <div class="emp-app-moderate-modal__icon" id="empAppModerateModalIcon" aria-hidden="true">
                    <i class="bi bi-check-lg"></i>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title emp-app-moderate-modal__title" id="empAppModerateModalLabel">
                    Xác nhận chấp nhận ứng viên
                </h5>
                <p class="emp-app-moderate-modal__lead mb-2" id="empAppModerateModalLead"></p>
                <div class="emp-app-moderate-modal__detail" id="empAppModerateModalDetail"></div>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn emp-apps-btn emp-apps-btn--muted" data-bs-dismiss="modal">Hủy</button>
                <button type="submit"
                        class="btn emp-apps-btn emp-apps-btn--success"
                        id="empAppModerateModalConfirm"
                        disabled
                        aria-disabled="true">
                    <i class="bi bi-check-lg me-1"></i> Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="applicantProfileModal" tabindex="-1" aria-labelledby="applicantProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="applicantProfileModalLabel">Thông tin ứng viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-2">
                <div id="applicantProfileLoading" class="text-center py-4 text-muted d-none">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2">Đang tải...</span>
                </div>
                <div id="applicantProfileError" class="alert alert-warning d-none mb-0"></div>
                <div id="applicantProfileContent" class="applicant-profile-modal d-none">
                    <div class="d-flex gap-3 align-items-start mb-3">
                        <div id="applicantProfileAvatarWrap" class="applicant-profile-modal__avatar rounded-circle flex-shrink-0" aria-hidden="true">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="min-w-0">
                            <h6 id="applicantProfileName" class="fw-bold mb-1 fs-5"></h6>
                            <p id="applicantProfileJob" class="text-muted small mb-0"></p>
                        </div>
                    </div>

                    <ul class="nav nav-tabs applicant-profile-modal__tabs mb-3" id="applicantProfileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="applicant-profile-info-tab" data-bs-toggle="tab"
                                    data-bs-target="#applicantProfileInfoPane" type="button" role="tab"
                                    aria-controls="applicantProfileInfoPane" aria-selected="true">
                                <i class="bi bi-person-lines-fill me-1"></i> Thông tin
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="applicant-profile-reviews-tab" data-bs-toggle="tab"
                                    data-bs-target="#applicantProfileReviewsPane" type="button" role="tab"
                                    aria-controls="applicantProfileReviewsPane" aria-selected="false">
                                <i class="bi bi-star me-1"></i> Đánh giá
                                <span id="applicantProfileReviewsBadge" class="badge bg-secondary ms-1 d-none">0</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="applicantProfileTabContent">
                        <div class="tab-pane fade show active" id="applicantProfileInfoPane" role="tabpanel"
                             aria-labelledby="applicant-profile-info-tab" tabindex="0">
                            <div class="row g-3">
                                <div class="col-12" id="applicantProfileDescWrap">
                                    <label class="form-label text-muted small mb-1">Giới thiệu</label>
                                    <div id="applicantProfileDesc" class="employer-profile-modal__field p-3 rounded" style="white-space: pre-wrap;"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Email</label>
                                    <div id="applicantProfileEmail" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Số điện thoại</label>
                                    <div id="applicantProfilePhone" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Ngày sinh</label>
                                    <div id="applicantProfileDob" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Giới tính</label>
                                    <div id="applicantProfileGender" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label text-muted small mb-1">Địa chỉ thường trú</label>
                                    <div id="applicantProfilePermanent" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label text-muted small mb-1">Địa chỉ tạm trú</label>
                                    <div id="applicantProfileTemporary" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">CV đã nộp</label>
                                    <div id="applicantProfileResume" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Trạng thái đơn</label>
                                    <div id="applicantProfileStatus" class="employer-profile-modal__field p-2 px-3 rounded"></div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="applicantProfileReviewsPane" role="tabpanel"
                             aria-labelledby="applicant-profile-reviews-tab" tabindex="0">
                            <div id="applicantProfileReviewsSummary" class="applicant-profile-reviews-summary text-center mb-4 py-3 rounded bg-light border"></div>
                            <div id="applicantProfileReviewsList" class="applicant-profile-reviews-list d-flex flex-column gap-3"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section EmployerStyles {
    <link rel="stylesheet" href="~/css/employer-applicants.css" asp-append-version="true" />
}

@section EmployerScripts {
    <script src="~/js/applicant-profile-modal.js" asp-append-version="true"></script>
    <script>
        (function () {
            var modalEl = document.getElementById('empAppModerateModal');
            if (!modalEl) return;

            var confirmBtn = document.getElementById('empAppModerateModalConfirm');
            var iconEl = document.getElementById('empAppModerateModalIcon');
            var titleEl = document.getElementById('empAppModerateModalLabel');
            var leadEl = document.getElementById('empAppModerateModalLead');
            var detailEl = document.getElementById('empAppModerateModalDetail');

            var copy = {
                accept: {
                    modalClass: 'emp-app-moderate-modal--accept',
                    iconClass: 'bi-check-lg',
                    title: 'Xác nhận chấp nhận ứng viên',
                    lead: 'Ứng viên sẽ được chấp nhận cho vị trí này.',
                    confirmLabel: 'Chấp nhận',
                    confirmBtnClass: 'emp-apps-btn--success',
                    confirmIcon: 'bi-check-lg'
                },
                reject: {
                    modalClass: 'emp-app-moderate-modal--reject',
                    iconClass: 'bi-x-lg',
                    title: 'Xác nhận từ chối ứng viên',
                    lead: 'Ứng viên sẽ được đánh dấu từ chối. Trạng thái không thể đổi ngược.',
                    confirmLabel: 'Từ chối',
                    confirmBtnClass: 'emp-apps-btn--danger',
                    confirmIcon: 'bi-x-lg'
                }
            };

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function getTrigger(el) {
                return el && el.closest ? el.closest('.js-emp-app-moderate') : null;
            }

            function bindForm(trigger) {
                var action = trigger.getAttribute('data-moderate-action');
                var cfg = copy[action];
                if (!cfg || !confirmBtn) return;

                var formId = trigger.getAttribute('data-moderate-form');
                var applicantName = trigger.getAttribute('data-applicant-name') || '';
                var jobTitle = trigger.getAttribute('data-job-title') || '';

                modalEl.classList.remove('emp-app-moderate-modal--accept', 'emp-app-moderate-modal--reject');
                modalEl.classList.add(cfg.modalClass);

                if (iconEl) iconEl.innerHTML = '<i class="bi ' + cfg.iconClass + '"></i>';
                if (titleEl) titleEl.textContent = cfg.title;
                if (leadEl) leadEl.textContent = cfg.lead;
                if (detailEl) {
                    detailEl.innerHTML = applicantName
                        ? '<div><strong>' + escapeHtml(applicantName) + '</strong></div>'
                          + (jobTitle ? '<div class="text-muted small mt-1">' + escapeHtml(jobTitle) + '</div>' : '')
                        : '';
                }

                confirmBtn.className = 'btn emp-apps-btn ' + cfg.confirmBtnClass;
                confirmBtn.innerHTML = '<i class="bi ' + cfg.confirmIcon + ' me-1"></i> ' + cfg.confirmLabel;

                if (formId && document.getElementById(formId)) {
                    confirmBtn.setAttribute('form', formId);
                    confirmBtn.disabled = false;
                    confirmBtn.removeAttribute('aria-disabled');
                } else {
                    confirmBtn.removeAttribute('form');
                    confirmBtn.disabled = true;
                    confirmBtn.setAttribute('aria-disabled', 'true');
                }
            }

            document.querySelectorAll('.js-emp-app-moderate').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    var trigger = getTrigger(e.currentTarget);
                    if (trigger) bindForm(trigger);
                });
            });

            modalEl.addEventListener('show.bs.modal', function (e) {
                var trigger = getTrigger(e.relatedTarget);
                if (trigger) bindForm(trigger);
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                if (!confirmBtn) return;
                confirmBtn.removeAttribute('form');
                confirmBtn.disabled = true;
                confirmBtn.setAttribute('aria-disabled', 'true');
            });
        })();
    </script>
}
