@page "{id:long}"
@model JobPortal.Web.Pages.Jobs.DetailModel
@using JobPortal.Web.Models
@{
    ViewData["Title"] = Model.Job.Title;
    if (Model.IsEmployerViewer)
    {
        Layout = "/Pages/Employer/_EmployerPortalLayout.cshtml";
        ViewData["EmployerNavActive"] = EmployerPortalNavKeys.Jobs;
    }
}

@if (Model.IsEmployerViewer)
{
    <partial name="Shared/_JobDetailEmployer" />
}
else
{
<div class="container job-detail-page mt-4 mb-5">
    <partial name="Shared/_PageBackLink" model='new JobPortal.Web.Models.PageBackLinkModel {
        PagePath = "/Jobs/Index",
        Label = "Quay lại Việc làm"
    }' />

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="h2 mb-1">@Model.Job.Title</h1>
                            @if (Model.EmployerProfile != null)
                            {
                                <button type="button"
                                        class="btn btn-link employer-profile-trigger p-0 h5 mb-0 text-start"
                                        data-bs-toggle="modal"
                                        data-bs-target="#employerProfileModal"
                                        aria-label="Xem thông tin @Model.Job.EmployerName">
                                    <i class="bi bi-building me-1"></i>@Model.Job.EmployerName
                                    <i class="bi bi-info-circle ms-1 small opacity-75"></i>
                                </button>
                            }
                            else
                            {
                                <p class="text-primary h5 mb-0">
                                    <i class="bi bi-building me-1"></i>@Model.Job.EmployerName
                                </p>
                            }
                        </div>
                        <span class="badge @DetailModel.StatusBadgeClass(Model.Job.PostingStatus) p-2">
                            @DetailModel.FormatPostingStatus(Model.Job.PostingStatus)
                        </span>
                    </div>

                    @if (Model.IsClosed && Model.IsEmployerViewer)
                    {
                        <div class="alert alert-secondary">
                            Tin đã hết hạn và được đóng tự động. Bạn vẫn xem được nội dung chi tiết; ứng viên không thể nộp hồ sơ mới.
                        </div>
                    }
                    else if (Model.IsClosed)
                    {
                        <div class="alert alert-warning">
                            Tin tuyển dụng đã đóng, không nhận hồ sơ ứng tuyển mới.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-3 mb-4 text-muted">
                        <span><i class="bi bi-geo-alt"></i> @Model.Job.Location</span>
                        <span><i class="bi bi-currency-dollar"></i> @Model.Job.Salary</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Job.WorkingHours))
                        {
                            <span><i class="bi bi-clock"></i> @Model.Job.WorkingHours</span>
                        }
                    </div>

                    <hr />

                    <div class="job-description mt-4">
                        <h4 class="mb-3">Mô tả công việc</h4>
                        <div style="white-space: pre-wrap;">@Model.Job.Description</div>
                    </div>

                    @if (Model.JobImages.Count > 0)
                    {
                        <div class="mt-4">
                            <h4 class="mb-3">Hình ảnh</h4>
                            <div class="row g-2">
                                @foreach (var img in Model.JobImages)
                                {
                                    <div class="col-6 col-md-4">
                                        <a href="@img.Url" target="_blank" rel="noopener noreferrer" class="d-block border rounded overflow-hidden">
                                            <img src="@img.Url" alt="@(img.Name ?? "Ảnh tin")" class="img-fluid w-100 object-fit-cover" style="aspect-ratio:4/3;max-height:200px;" loading="lazy" />
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ApplySuccessMessage))
                    {
                        <div class="alert alert-success mt-4">@Model.ApplySuccessMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ApplyErrorMessage))
                    {
                        <div class="alert alert-danger mt-4">@Model.ApplyErrorMessage</div>
                    }

                    @if (Model.ShowApplyButton)
                    {
                        <div class="apply-panel mt-5">
                            <div class="apply-panel__header">
                                <h4 class="apply-panel__title mb-0">
                                    <i class="bi bi-send-check me-2"></i>Ứng tuyển
                                </h4>
                            </div>
                            <div class="apply-panel__body">
                                @if (Model.HasApplied)
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <span class="badge bg-success fs-6 px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i> Đã ứng tuyển
                                        </span>
                                        <a asp-page="/Applications/Index" class="btn btn-outline-primary">
                                            Xem đơn của tôi
                                        </a>
                                    </div>
                                }
                                else if (!Model.IsRecruiting)
                                {
                                    <p class="text-muted mb-0">
                                        @(Model.IsClosed ? "Tin tuyển dụng đã đóng, không nhận hồ sơ mới." : "Tin tuyển dụng hiện không nhận hồ sơ.")
                                    </p>
                                }
                                else if (!Model.IsLoggedIn)
                                {
                                    <p class="text-muted mb-3">Đăng nhập tài khoản ứng viên để nộp hồ sơ cho tin này.</p>
                                    <a asp-page="/Auth/Login"
                                       asp-route-returnUrl="@Model.ReturnUrl"
                                       class="btn btn-primary btn-lg">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập để ứng tuyển
                                    </a>
                                }
                                else if (!Model.IsJobSeeker)
                                {
                                    <p class="text-muted mb-0">Chỉ tài khoản ứng viên mới có thể ứng tuyển.</p>
                                }
                                else if (Model.Resumes.Count == 0)
                                {
                                    <p class="text-muted mb-3">Bạn cần tải lên ít nhất một hồ sơ (CV) trước khi ứng tuyển.</p>

                                    @if (!string.IsNullOrEmpty(Model.ResumeSuccessMessage))
                                    {
                                        <div class="alert alert-success">@Model.ResumeSuccessMessage</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ResumeErrorMessage))
                                    {
                                        <div class="alert alert-danger">@Model.ResumeErrorMessage</div>
                                    }

                                    <button type="button"
                                            class="btn btn-primary btn-lg"
                                            id="toggleAddResumeFormBtn"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#addResumeForm"
                                            aria-expanded="@(Model.ShowAddResumeForm ? "true" : "false")"
                                            aria-controls="addResumeForm">
                                        <i class="bi bi-file-earmark-plus me-1"></i> Thêm hồ sơ (CV)
                                    </button>

                                    <div class="collapse @(Model.ShowAddResumeForm ? "show" : "") mt-3" id="addResumeForm">
                                        <div class="apply-resume-form card border-0 bg-light">
                                            <div class="card-body p-4">
                                                <h5 class="h6 fw-semibold mb-3">
                                                    <i class="bi bi-file-earmark-arrow-up me-2"></i>Thêm hồ sơ CV
                                                </h5>
                                                <form method="post"
                                                      enctype="multipart/form-data"
                                                      asp-page-handler="AddResume"
                                                      asp-route-id="@Model.Job.Id"
                                                      class="apply-resume-form__inner">
                                                    <div class="mb-3">
                                                        <label class="form-label" for="ResumeInput_Title">Tiêu đề hồ sơ</label>
                                                        <input type="text"
                                                               class="form-control"
                                                               id="ResumeInput_Title"
                                                               asp-for="ResumeInput.Title"
                                                               maxlength="255"
                                                               required
                                                               placeholder="VD: CV Frontend 2025" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label" for="resumeFile">File CV (PDF)</label>
                                                        <input type="file"
                                                               class="form-control"
                                                               id="resumeFile"
                                                               name="resumeFile"
                                                               accept="application/pdf,.pdf"
                                                               required />
                                                        <div class="form-text">Chỉ PDF, tối đa 10 MB.</div>
                                                    </div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        <button type="submit" class="btn btn-primary">
                                                            <i class="bi bi-plus-lg me-1"></i> Lưu hồ sơ
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-outline-secondary"
                                                                data-bs-toggle="collapse"
                                                                data-bs-target="#addResumeForm">
                                                            Hủy
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Apply" asp-route-id="@Model.Job.Id" class="apply-form">
                                        <p class="apply-panel__hint text-muted small mb-3">
                                            @(Model.Resumes.Count > 1
                                                ? "Chọn hồ sơ CV bạn muốn gửi cho nhà tuyển dụng."
                                                : "Hồ sơ dưới đây sẽ được gửi kèm đơn ứng tuyển.")
                                        </p>

                                        <div class="row g-3 mb-4">
                                            @foreach (var cv in Model.Resumes)
                                            {
                                                <div class="@(Model.Resumes.Count > 1 ? "col-sm-6" : "col-12")">
                                                    <label class="apply-cv-option">
                                                        <input type="radio"
                                                               class="apply-cv-option__input"
                                                               asp-for="SelectedResumeId"
                                                               value="@cv.Id" />
                                                        <span class="apply-cv-option__card">
                                                            <span class="apply-cv-option__icon" aria-hidden="true">
                                                                <i class="bi bi-file-earmark-pdf"></i>
                                                            </span>
                                                            <span class="apply-cv-option__content">
                                                                <span class="apply-cv-option__title">@cv.Title</span>
                                                                @if (!string.IsNullOrWhiteSpace(cv.Url))
                                                                {
                                                                    <a href="@cv.Url"
                                                                       target="_blank"
                                                                       rel="noopener noreferrer"
                                                                       class="apply-cv-option__link small"
                                                                       onclick="event.stopPropagation();">
                                                                        Xem CV <i class="bi bi-box-arrow-up-right ms-1"></i>
                                                                    </a>
                                                                }
                                                            </span>
                                                            <span class="apply-cv-option__check" aria-hidden="true">
                                                                <i class="bi bi-check-lg"></i>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                            }
                                        </div>

                                        <div class="apply-panel__actions">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <i class="bi bi-send me-1"></i> Ứng tuyển ngay
                                            </button>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="job-detail-location card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h4 class="job-detail-block__title mb-3">Địa điểm làm việc</h4>
                    <p class="mb-1">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                        <strong>@Model.Job.Location</strong>
                    </p>
                </div>
            </div>

            <partial name="Shared/_JobRelatedSection"
                     model='("Việc làm gợi ý", false, Model.SuggestedJobs, false)' />
        </div>

        <div class="col-lg-4">
            <div class="job-detail-sidebar sticky-top" style="top: 20px;">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body p-4">
                        <h5 class="job-detail-block__title mb-3">Thông tin chung</h5>
                        <dl class="job-detail-meta mb-0">
                            <dt>Mức lương</dt>
                            <dd>@Model.Job.Salary</dd>
                            <dt>Nhà tuyển dụng</dt>
                            <dd>
                                @if (Model.EmployerProfile != null)
                                {
                                    <button type="button"
                                            class="btn btn-link employer-profile-trigger p-0 align-baseline"
                                            data-bs-toggle="modal"
                                            data-bs-target="#employerProfileModal">
                                        @Model.Job.EmployerName
                                    </button>
                                }
                                else
                                {
                                    @Model.Job.EmployerName
                                }
                            </dd>
                            <dt>Thời gian làm việc</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Job.WorkingHours) ? "—" : Model.Job.WorkingHours)</dd>
                            <dt>Hết hạn tin</dt>
                            <dd>@Model.Job.ExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                        </dl>
                    </div>
                </div>

                @if (Model.SameCompanyJobs.Count > 0)
                {
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body p-4">
                            <partial name="Shared/_JobRelatedSection"
                                     model='("Việc làm cùng công ty", true, Model.SameCompanyJobs, true)' />
                        </div>
                    </div>
                }

                @if (Model.SimilarJobs.Count > 0)
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">
                            <partial name="Shared/_JobRelatedSection"
                                     model='("Việc làm tương tự", true, Model.SimilarJobs, true)' />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
}

@if (!Model.IsEmployerViewer && Model.EmployerProfile != null)
{
    var emp = Model.EmployerProfile;
    <div class="modal fade" id="employerProfileModal" tabindex="-1" aria-labelledby="employerProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="employerProfileModalLabel">Thông tin nhà tuyển dụng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body pt-2">
                    <div class="employer-profile-modal">
                        <div class="employer-profile-modal__header d-flex gap-3 align-items-start mb-3">
                            @if (!string.IsNullOrWhiteSpace(emp.Image))
                            {
                                <img src="@emp.Image" alt="" class="employer-profile-modal__avatar rounded-circle object-fit-cover" width="72" height="72" />
                            }
                            else
                            {
                                <div class="employer-profile-modal__avatar employer-profile-modal__avatar--placeholder rounded-circle" aria-hidden="true">
                                    <i class="bi bi-building"></i>
                                </div>
                            }
                            <div class="min-w-0">
                                <h6 class="fw-bold mb-1 fs-5">@emp.Name</h6>
                                <p class="text-muted small mb-0">Đơn vị đăng tin tuyển dụng này</p>
                            </div>
                        </div>

                        <ul class="nav nav-tabs applicant-profile-modal__tabs mb-3" id="employerProfileTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="employer-profile-info-tab" data-bs-toggle="tab"
                                        data-bs-target="#employerProfileInfoPane" type="button" role="tab"
                                        aria-controls="employerProfileInfoPane" aria-selected="true">
                                    <i class="bi bi-building me-1"></i> Thông tin
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="employer-profile-reviews-tab" data-bs-toggle="tab"
                                        data-bs-target="#employerProfileReviewsPane" type="button" role="tab"
                                        aria-controls="employerProfileReviewsPane" aria-selected="false">
                                    <i class="bi bi-star me-1"></i> Đánh giá
                                    @if (emp.Reviews.TotalCount > 0)
                                    {
                                        <span class="badge bg-secondary ms-1">@emp.Reviews.TotalCount</span>
                                    }
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="employerProfileTabContent">
                            <div class="tab-pane fade show active" id="employerProfileInfoPane" role="tabpanel"
                                 aria-labelledby="employer-profile-info-tab" tabindex="0">
                                <div class="row g-3">
                                    @if (!string.IsNullOrWhiteSpace(emp.Description))
                                    {
                                        <div class="col-12">
                                            <label class="form-label text-muted small mb-1">Giới thiệu</label>
                                            <div class="employer-profile-modal__field p-3 rounded" style="white-space: pre-wrap;">@emp.Description</div>
                                        </div>
                                    }
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small mb-1">Email liên hệ</label>
                                        <div class="employer-profile-modal__field p-2 px-3 rounded">
                                            @if (!string.IsNullOrWhiteSpace(emp.Email))
                                            {
                                                <a href="mailto:@emp.Email">@emp.Email</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small mb-1">Số điện thoại</label>
                                        <div class="employer-profile-modal__field p-2 px-3 rounded">
                                            @if (!string.IsNullOrWhiteSpace(emp.Phone))
                                            {
                                                <a href="tel:@emp.Phone">@emp.Phone</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </div>
                                    </div>
                                    @if (emp.Gender is not null)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label text-muted small mb-1">Giới tính (người đại diện)</label>
                                            <div class="employer-profile-modal__field p-2 px-3 rounded">
                                                @DetailModel.FormatGender(emp.Gender)
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="tab-pane fade" id="employerProfileReviewsPane" role="tabpanel"
                                 aria-labelledby="employer-profile-reviews-tab" tabindex="0">
                                <partial name="Shared/_AccountReceivedReviewsTab"
                                         model="JobPortal.Web.Models.ReceivedReviewsPanelModel.FromEmployerPublic(emp.Reviews)" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function () {
            const modal = document.getElementById("employerProfileModal");
            const infoTab = document.getElementById("employer-profile-info-tab");
            if (!modal || !infoTab) return;
            modal.addEventListener("hidden.bs.modal", () => {
                if (window.bootstrap?.Tab) {
                    bootstrap.Tab.getOrCreateInstance(infoTab).show();
                }
            });
        })();
    </script>
}

@if (Model.IsEmployerViewer)
{
    @section EmployerStyles {
        <link rel="stylesheet" href="~/css/employer-jobs.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/employer-job-detail.css" asp-append-version="true" />
    }
}
else
{
    @section Styles {
        <link rel="stylesheet" href="~/css/job-detail.css" asp-append-version="true" />
    }
}
