@model JobPortal.Web.Models.JobGridCardModel
@using JobPortal.Web.Pages.Employer
@{
    var isRecruiting = string.Equals(Model.PostingStatus, "recruiting", StringComparison.OrdinalIgnoreCase);
    var isClosed = string.Equals(Model.PostingStatus, "closed", StringComparison.OrdinalIgnoreCase);
    var isPending = string.Equals(Model.PostingStatus, "pending", StringComparison.OrdinalIgnoreCase);
    var isRejected = string.Equals(Model.PostingStatus, "rejected", StringComparison.OrdinalIgnoreCase);
    var showEmployerStatusBadge = Model.ShowEmployerActions || Model.ShowEmployerPostingStatus;
    var statusBadgeClass = showEmployerStatusBadge
        ? (isRecruiting ? "employer-badge--open"
            : isPending ? "employer-badge--pending"
            : isRejected ? "employer-badge--rejected"
            : isClosed ? "employer-badge--closed"
            : "employer-badge--draft")
        : "home-badge-status";
    var hasApplicantCount = Model.ApplicantCount is int;
    var hasWorkingHours = Model.ShowEmployerActions && !string.IsNullOrWhiteSpace(Model.WorkingHours);
    var metaLastClass = hasApplicantCount || hasWorkingHours ? "mb-1" : "";
}

<article class="job-card job-grid-card card border-0 shadow-sm h-100 w-100@(Model.ShowEmployerActions ? " job-grid-card--employer" : "")">
    <div class="job-grid-card__media">
        @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
        {
            <img src="@Model.ThumbnailUrl"
                 alt="@Model.Title"
                 class="job-grid-card__img"
                 loading="lazy" />
        }
        else
        {
            <div class="job-grid-card__placeholder" aria-hidden="true">
                <i class="bi bi-briefcase"></i>
            </div>
        }
        <span class="badge @statusBadgeClass job-grid-card__badge">
            @JobPortal.Web.Pages.IndexModel.FormatJobStatus(Model.PostingStatus)
        </span>
    </div>
    <div class="card-body position-relative d-flex flex-column">
        <small class="text-muted job-grid-card__date">
            <i class="bi bi-clock me-1"></i>Hết hạn @Model.ExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")
        </small>
        <h3 class="h6 card-title job-grid-card__title">
            <a asp-page="/Jobs/Detail" asp-route-id="@Model.Id"
               class="job-card__title text-decoration-none @(Model.ShowEmployerActions ? "" : "stretched-link")">
                @Model.Title
            </a>
        </h3>
        @if (!Model.ShowEmployerActions && !string.IsNullOrWhiteSpace(Model.EmployerName))
        {
            <div class="job-grid-card__employer small mb-2">
                <span class="text-muted text-truncate d-inline-block align-middle me-1" style="max-width: 55%;">
                    <i class="bi bi-building me-1"></i>@Model.EmployerName
                </span>
                <partial name="Shared/_RatingStars"
                         model="JobPortal.Web.Models.RatingStarsModel.FromEmployer(Model.EmployerAverageRating, Model.EmployerReviewCount)" />
            </div>
        }
        else if (Model.ShowEmployerActions)
        {
            <div class="job-grid-card__employer small mb-2">
                <span class="text-muted me-1">Đánh giá công ty</span>
                <partial name="Shared/_RatingStars"
                         model="JobPortal.Web.Models.RatingStarsModel.FromEmployer(Model.EmployerAverageRating, Model.EmployerReviewCount)" />
            </div>
        }
        <p class="text-muted small job-grid-card__desc">@Model.Description</p>
        <ul class="list-unstyled small mb-0 job-card__meta job-grid-card__meta mt-auto">
            <li class="mb-1 text-truncate">
                <i class="bi bi-geo-alt text-primary me-1"></i>@Model.Location
            </li>
            <li class="@metaLastClass text-truncate">
                <i class="bi bi-cash-stack text-primary me-1"></i>@JobPortal.Web.Pages.IndexModel.FormatSalary(Model.Salary)
            </li>
            @if (hasWorkingHours)
            {
                <li class="@(hasApplicantCount ? "mb-1" : "") text-truncate">
                    <i class="bi bi-clock text-primary me-1"></i>@Model.WorkingHours
                </li>
            }
            @if (Model.ApplicantCount is int applicantCount)
            {
                <li class="text-truncate">
                    <i class="bi bi-people text-primary me-1"></i>@applicantCount ứng viên
                </li>
            }
        </ul>
        @if (Model.ShowEmployerActions)
        {
            <div class="job-grid-card__actions d-flex flex-wrap gap-2 mt-3">
                @if (isRecruiting || isClosed)
                {
                    <a asp-page="/Employer/Applicants" class="btn btn-sm employer-jobs-btn employer-jobs-btn--info">Xem CV</a>
                    <a asp-page="/Jobs/Detail" asp-route-id="@Model.Id" class="btn btn-sm employer-jobs-btn employer-jobs-btn--muted">Chi tiết</a>
                    @if (isRecruiting)
                    {
                        <form method="post"
                              asp-page="/Employer/Jobs"
                              asp-page-handler="CloseJob"
                              asp-route-jobId="@Model.Id"
                              asp-route-view="@(Model.ListViewFilter ?? JobsModel.ViewAll)"
                              asp-route-q="@Model.ListSearch"
                              asp-route-pageNumber="@Model.ListPageNumber"
                              asp-route-pageSize="@Model.ListPageSize"
                              class="d-inline"
                              onsubmit="return confirm('Đóng tin này? Ứng viên sẽ không thể nộp CV mới.');">
                            <button type="submit" class="btn btn-sm employer-jobs-btn employer-jobs-btn--danger">Đóng tin</button>
                        </form>
                    }
                }
                else if (isPending)
                {
                    <span class="btn btn-sm employer-jobs-btn employer-jobs-btn--muted disabled" tabindex="-1" aria-disabled="true">Chờ admin duyệt</span>
                }
                else if (isRejected)
                {
                    <a asp-page="/Employer/PostJob" class="btn btn-sm employer-jobs-btn employer-jobs-btn--primary">Đăng tin mới</a>
                }
                else
                {
                    <a asp-page="/Employer/PostJob" class="btn btn-sm employer-jobs-btn employer-jobs-btn--info">Tiếp tục chỉnh sửa</a>
                }
            </div>
        }
    </div>
</article>
