@model JobPortal.Web.Pages.Jobs.IndexModel
@{
    var fp = ViewData["FilterIdPrefix"] as string ?? "f";
}

<div class="jobs-listing-filters__head">
    <h2><i class="bi bi-funnel me-1"></i> Bộ lọc</h2>
    @if (Model.HasActiveFilter)
    {
        <a asp-page="/Jobs/Index" class="small text-decoration-none">Xóa tất cả</a>
    }
</div>

<input type="hidden" name="pageNumber" value="1" />
<input type="hidden" name="pageSize" value="@Model.PageSize" />

<div class="jobs-listing-filters__section">
    <div class="jobs-listing-filters__section-title">Từ khóa</div>
    <input type="search" class="form-control form-control-sm" name="q" value="@Model.Q"
           placeholder="Tiêu đề, mô tả..." maxlength="200" />
</div>

<div class="jobs-listing-filters__section">
    <div class="jobs-listing-filters__section-title">Địa điểm</div>
    <input type="search" class="form-control form-control-sm" name="location" value="@Model.Location"
           placeholder="Thành phố, quận..." maxlength="200" />
</div>

<div class="jobs-listing-filters__section">
    <div class="jobs-listing-filters__section-title">Ngành nghề</div>
    <div class="jobs-listing-filters__checks">
        <div class="form-check">
            <input class="form-check-input" type="radio" name="categoryId" id="@($"{fp}-cat-all")"
                   value="0" @(Model.CategoryId is null or <= 0 ? "checked" : "") />
            <label class="form-check-label" for="@($"{fp}-cat-all")">Tất cả ngành</label>
        </div>
        @foreach (var cat in Model.Categories)
        {
            var cid = $"{fp}-cat-{cat.Id}";
            <div class="form-check">
                <input class="form-check-input" type="radio" name="categoryId" id="@cid"
                       value="@cat.Id" @(Model.CategoryId == cat.Id ? "checked" : "") />
                <label class="form-check-label" for="@cid">@cat.Name</label>
            </div>
        }
    </div>
</div>

<button type="submit" class="btn btn-primary w-100 mt-3" style="border-radius: 10px;">
    <i class="bi bi-check2 me-1"></i> Áp dụng
</button>
