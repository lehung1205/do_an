@page
@model JobPortal.Web.Pages.Admin.Jobs.IndexModel
@{
    ViewData["Title"] = "Duyệt tin tuyển dụng";
    var isPendingTab = Model.StatusFilter == IndexModel.StatusPending;
}

<div class="admin-portal">
    <div class="container admin-portal__container py-4">
    <partial name="Shared/_AdminPageHeader" model='("Quản lý tin tuyển dụng", "Lọc tin chờ duyệt, đã duyệt hoặc bị từ chối · Tin chờ quá 24h có thể tự duyệt", "bi-shield-check")' />

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ActionErrorMessage))
    {
        <div class="alert alert-warning">@Model.ActionErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    <ul class="nav nav-tabs admin-portal__tabs">
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == IndexModel.StatusPending ? "active" : "")"
               asp-page="/Admin/Jobs/Index"
               asp-route-status="@IndexModel.StatusPending"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize">Chờ duyệt</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == IndexModel.StatusApproved ? "active" : "")"
               asp-page="/Admin/Jobs/Index"
               asp-route-status="@IndexModel.StatusApproved"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize">Đã duyệt</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == IndexModel.StatusRejected ? "active" : "")"
               asp-page="/Admin/Jobs/Index"
               asp-route-status="@IndexModel.StatusRejected"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize">Từ chối</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == IndexModel.StatusAll ? "active" : "")"
               asp-page="/Admin/Jobs/Index"
               asp-route-status="@IndexModel.StatusAll"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize">Tất cả</a>
        </li>
    </ul>

    <form method="get" class="admin-portal__panel mb-4">
        <div class="card-body">
            <input type="hidden" name="status" value="@Model.StatusFilter" />
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-7">
                    <label class="form-label" for="q">Tìm kiếm</label>
                    <input type="search" class="form-control" id="q" name="q" value="@Model.Search"
                           placeholder="Tiêu đề, mô tả, địa điểm, tên công ty..." maxlength="200" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label d-none d-md-block">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> Lọc
                    </button>
                </div>
                <div class="col-md-3 col-lg-3">
                    <label class="form-label d-none d-md-block">&nbsp;</label>
                    <div class="d-flex gap-2">
                    <a class="btn btn-success flex-grow-1"
                       asp-page="/Admin/Jobs/Index"
                       asp-page-handler="ExportJobsExcel"
                       asp-route-status="@Model.StatusFilter"
                       asp-route-q="@Model.Search"
                       title="Xuất danh sách theo bộ lọc hiện tại">
                        <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
                    </a>
                    <a asp-page="/Admin/Jobs/Index"
                       asp-route-status="@Model.StatusFilter"
                       class="btn btn-outline-secondary" title="Xóa từ khóa">
                        <i class="bi bi-x-lg"></i>
                    </a>
                    </div>
                </div>
            </div>
            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </div>
    </form>

    @if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        @if (Model.TotalCount > 0)
        {
            <p class="admin-portal__toolbar">@Model.TotalCount @Model.ListSummaryLabel</p>
        }

        @if (Model.Jobs.Count == 0)
        {
            <div class="admin-portal__empty">
                <i class="bi bi-inbox"></i>
                <p class="mb-0">@Model.EmptyListMessage</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var job in Model.Jobs)
                {
                    var statusKey = job.PostingStatus.Trim().ToLowerInvariant();
                    var showModerationActions = string.Equals(statusKey, IndexModel.StatusPending, StringComparison.Ordinal);
                    <div class="col-12">
                        <article class="admin-job-card">
                            <div class="row g-0">
                                <div class="col-md-3 col-lg-2">
                                    @if (!string.IsNullOrWhiteSpace(job.ThumbnailUrl))
                                    {
                                        <img src="@job.ThumbnailUrl" alt="" class="admin-job-card__thumb w-100 h-100 object-fit-cover" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="admin-job-card__placeholder d-flex align-items-center justify-content-center h-100 min-h-120">
                                            <i class="bi bi-briefcase fs-2 text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-9 col-lg-10">
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                            <h3 class="h5 mb-0">@job.Title</h3>
                                            <span class="badge @IndexModel.StatusBadgeClass(job.PostingStatus)">
                                                @IndexModel.FormatStatus(job.PostingStatus)
                                            </span>
                                        </div>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-building me-1"></i>@job.EmployerName
                                            @if (!string.IsNullOrWhiteSpace(job.EmployerEmail))
                                            {
                                                <span class="mx-1">·</span>
                                                <i class="bi bi-envelope me-1"></i>@job.EmployerEmail
                                            }
                                            <span class="mx-1">·</span>
                                            <i class="bi bi-tag me-1"></i>@job.CategoryName
                                        </p>
                                        <p class="small mb-2 text-truncate-3">@job.Description</p>
                                        <ul class="list-unstyled small mb-3">
                                            <li><i class="bi bi-geo-alt text-primary me-1"></i>@job.Location</li>
                                            <li><i class="bi bi-cash-stack text-primary me-1"></i>@job.Salary</li>
                                            @if (!string.IsNullOrWhiteSpace(job.WorkingHours))
                                            {
                                                <li><i class="bi bi-clock text-primary me-1"></i>@job.WorkingHours</li>
                                            }
                                            <li>
                                                <i class="bi bi-calendar-plus text-primary me-1"></i>Đăng @job.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                <span class="mx-1">·</span>
                                                <i class="bi bi-calendar-event text-primary me-1"></i>Hết hạn @job.ExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")
                                            </li>
                                        </ul>
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            @if (showModerationActions)
                                            {
                                                <form method="post" asp-page-handler="Approve" class="d-inline"
                                                      onsubmit="return confirm('Duyệt tin này? Tin sẽ hiển thị công khai.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="jobId" value="@job.Id" />
                                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                    <input type="hidden" name="q" value="@Model.Search" />
                                                    <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="bi bi-check-lg me-1"></i>Duyệt
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Reject" class="d-inline"
                                                      onsubmit="return confirm('Từ chối tin này? Lượt đăng tin sẽ được hoàn lại cho nhà tuyển dụng.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="jobId" value="@job.Id" />
                                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                    <input type="hidden" name="q" value="@Model.Search" />
                                                    <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-x-lg me-1"></i>Từ chối
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <a asp-page="/Jobs/Detail" asp-route-id="@job.Id" target="_blank" rel="noopener"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem tin
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.ShowPagination)
            {
                <nav class="mt-4" aria-label="Phân trang duyệt tin">
                    <ul class="pagination justify-content-center flex-wrap mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/Jobs/Index"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-q="@Model.Search">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Admin/Jobs/Index"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-q="@Model.Search">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/Jobs/Index"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-q="@Model.Search">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-muted small text-center mt-2 mb-0">
                        Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount @Model.ListSummaryLabel
                    </p>
                </nav>
            }
        }
    }
    </div>
</div>
