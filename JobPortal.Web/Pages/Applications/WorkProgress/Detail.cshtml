@page
@model JobPortal.Web.Pages.Applications.WorkProgress.DetailModel
@{
    ViewData["Title"] = "Chi tiết tiến độ";
}

<div class="container py-4 seeker-work-progress-page">
    <partial name="Shared/_PageBackLink" model='new JobPortal.Web.Models.PageBackLinkModel {
        PagePath = "/Applications/WorkProgress/Index",
        Label = "Quay lại danh sách tiến độ"
    }' />

    @if (Model.Progress == null)
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-warning">@Model.ErrorMessage</div>
        }
        <a asp-page="/Applications/WorkProgress/Index" class="btn work-progress-btn work-progress-btn--muted">Quay lại</a>
    }
    else
    {
        var p = Model.Progress;

        <section class="card border-0 shadow-sm mb-4 seeker-work-progress-detail-hero">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div class="min-w-0">
                        <h2 class="h5 mb-1">@p.JobTitle</h2>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-building me-1"></i>@p.CompanyName
                        </p>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-geo-alt me-1"></i>@p.JobLocation
                            · <i class="bi bi-cash-stack me-1"></i>@p.JobSalary
                            · Ứng tuyển @DetailModel.FormatRelativeTime(p.AppliedAt)
                        </p>
                    </div>
                    @if (p.CurrentStep != null)
                    {
                        <span class="badge @JobPortal.Web.Helpers.WorkProgressCatalog.BadgeClass(p.CurrentStep.Status) fs-6">
                            Hiện tại: @p.CurrentStep.Title
                        </span>
                    }
                </div>
            </div>
        </section>

        @if (p.IsProgressLocked)
        {
            <div class="alert alert-secondary seeker-work-progress-lock-alert">
                <i class="bi bi-lock-fill me-1"></i>
                Tiến độ đã kết thúc
                @if (p.CurrentStep != null)
                {
                    <text>(<strong>@JobPortal.Web.Helpers.WorkProgressCatalog.FormatStatus(p.CurrentStep.Status)</strong>)</text>
                }
                . Bạn chỉ có thể xem lịch sử tiến độ.
            </div>
        }

        <div class="seeker-work-progress-section-head">
            <h3 class="h6 mb-0"><i class="bi bi-list-check me-2"></i>Lịch sử tiến độ</h3>
        </div>
        @if (p.Steps.Count == 0)
        {
            <div class="card border-0 shadow-sm text-muted small py-4 text-center seeker-work-progress-empty">
                Nhà tuyển dụng chưa cập nhật bước tiến độ nào.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 seeker-work-progress-timeline">
                @foreach (var step in p.Steps)
                {
                    <div class="card border-0 shadow-sm border-start border-4 border-primary seeker-work-progress-step">
                        <div class="card-body ps-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                                <span class="fw-semibold">@step.Title</span>
                                <span class="badge @JobPortal.Web.Helpers.WorkProgressCatalog.BadgeClass(step.Status)">
                                    @JobPortal.Web.Helpers.WorkProgressCatalog.FormatStatus(step.Status)
                                </span>
                            </div>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-clock me-1"></i>@step.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(step.Notes))
                            {
                                <p class="small mb-0 mt-2" style="white-space: pre-wrap;">@step.Notes</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.ReviewContext != null)
        {
            ViewData["ReviewFormPage"] = "/Applications/WorkProgress/Detail";
            ViewData["ReviewApplicationId"] = Model.ApplicationId;
            ViewData["ReviewPanelTitle"] = "Đánh giá nhà tuyển dụng";
            ViewData["ReceivedReviewLabel"] = "Đánh giá từ nhà tuyển dụng:";
            ViewData["CommentPlaceholder"] = "Chia sẻ trải nghiệm làm việc với công ty...";
            <partial name="Shared/_ApplicationReviewPanel" model="Model.ReviewContext" />
        }

        <div class="mt-4 d-flex flex-wrap gap-2 seeker-work-progress-detail-actions">
            <a asp-page="/Applications/WorkProgress/Index" class="btn work-progress-btn work-progress-btn--muted">
                <i class="bi bi-arrow-left me-1"></i> Danh sách tiến độ
            </a>
            <a asp-page="/Jobs/Detail" asp-route-id="@p.JobId" class="btn work-progress-btn work-progress-btn--info">Xem tin tuyển dụng</a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/seeker-work-progress.css" asp-append-version="true" />
}
