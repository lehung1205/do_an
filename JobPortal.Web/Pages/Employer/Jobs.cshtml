@page
@model JobPortal.Web.Pages.Employer.JobsModel
@using JobPortal.Web.Models
@using static JobPortal.Web.Pages.Employer.JobsModel
@{
    ViewData["Title"] = "Tin tuyển dụng";
    ViewData["EmployerNavActive"] = EmployerPortalNavKeys.Jobs;
}

<partial name="Shared/_EmployerPageHeader" model='new EmployerPageHeaderModel {
    Title = "Tin tuyển dụng",
    Subtitle = "Quản lý các tin đã đăng của công ty bạn",
    CtaText = "Đăng tin mới",
    CtaPage = "/Employer/PostJob"
}' />

<div class="employer-dash__panel-stack employer-jobs-page">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ActionErrorMessage))
    {
        <div class="alert alert-warning">@Model.ActionErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    @if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <nav class="employer-jobs-overview" aria-label="Lọc tin tuyển dụng">
            <a asp-page="/Employer/Jobs"
               asp-route-view="@ViewAll"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize"
               class="employer-jobs-overview__card @(Model.ViewFilter == ViewAll ? "is-active" : "")">
                <span class="employer-jobs-overview__icon employer-jobs-overview__icon--primary"><i class="bi bi-briefcase"></i></span>
                <div>
                    <p class="employer-jobs-overview__label">Tổng tin</p>
                    <p class="employer-jobs-overview__value">@((Model.Stats?.TotalJobs ?? Model.TotalCount).ToString())</p>
                </div>
            </a>
            <a asp-page="/Employer/Jobs"
               asp-route-view="@ViewRecruiting"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize"
               class="employer-jobs-overview__card @(Model.ViewFilter == ViewRecruiting ? "is-active" : "")">
                <span class="employer-jobs-overview__icon employer-jobs-overview__icon--success"><i class="bi bi-broadcast-pin"></i></span>
                <div>
                    <p class="employer-jobs-overview__label">Đang tuyển</p>
                    <p class="employer-jobs-overview__value">@((Model.Stats?.OpenJobs ?? 0).ToString())</p>
                </div>
            </a>
            <a asp-page="/Employer/Jobs"
               asp-route-view="@ViewUnreadCv"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize"
               class="employer-jobs-overview__card @(Model.ViewFilter == ViewUnreadCv ? "is-active" : "")">
                <span class="employer-jobs-overview__icon employer-jobs-overview__icon--warning"><i class="bi bi-person-lines-fill"></i></span>
                <div>
                    <p class="employer-jobs-overview__label">CV chưa đọc</p>
                    <p class="employer-jobs-overview__value">@((Model.Stats?.UnreadApplications ?? 0).ToString())</p>
                </div>
            </a>
            <a asp-page="/Employer/Jobs"
               asp-route-view="@ViewHasCv"
               asp-route-q="@Model.Search"
               asp-route-pageNumber="1"
               asp-route-pageSize="@Model.PageSize"
               class="employer-jobs-overview__card @(Model.ViewFilter == ViewHasCv ? "is-active" : "")">
                <span class="employer-jobs-overview__icon employer-jobs-overview__icon--info"><i class="bi bi-people"></i></span>
                <div>
                    <p class="employer-jobs-overview__label">Tổng CV</p>
                    <p class="employer-jobs-overview__value">@((Model.Stats?.TotalCvCount ?? 0).ToString())</p>
                </div>
            </a>
        </nav>

        <form method="get" class="employer-panel employer-jobs-filter mb-0">
            <div class="employer-jobs-filter__head">
                <h3><i class="bi bi-search me-2"></i>Tìm kiếm tin tuyển dụng</h3>
                @if (Model.HasActiveFilter)
                {
                    <span class="employer-jobs-filter__hint">Đang áp dụng bộ lọc</span>
                }
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label" for="q">Tìm kiếm</label>
                    <input type="search" class="form-control" id="q" name="q" value="@Model.Search"
                           placeholder="Tiêu đề, mô tả, địa điểm, lương..." maxlength="200" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn employer-jobs-btn employer-jobs-btn--primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Tìm
                    </button>
                    <a asp-page="/Employer/Jobs" class="btn employer-jobs-btn employer-jobs-btn--muted" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
            <input type="hidden" name="view" value="@Model.ViewFilter" />
            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </form>

        @if (Model.Jobs.Count == 0)
        {
            <div class="employer-panel employer-jobs-empty text-center py-5 text-muted">
                @if (Model.HasActiveFilter)
                {
                    <i class="bi bi-funnel display-6 d-block mb-2"></i>
                    <p class="mb-2">Không có tin phù hợp bộ lọc.</p>
                    <a asp-page="/Employer/Jobs" class="btn btn-sm employer-jobs-btn employer-jobs-btn--info">Xóa bộ lọc</a>
                }
                else
                {
                    <p class="mb-2">Bạn chưa có tin tuyển dụng nào.</p>
                    <a asp-page="/Employer/PostJob" class="btn btn-sm employer-jobs-btn employer-jobs-btn--primary">
                        <i class="bi bi-plus-circle me-1"></i>Đăng tin đầu tiên
                    </a>
                }
            </div>
        }
        else
        {
            <div class="employer-jobs-list-head">
                <h3>Danh sách tin tuyển dụng</h3>
                <p>
                    Hiển thị <strong>@Model.Jobs.Count</strong> / <strong>@Model.TotalCount</strong> tin
                    @if (!string.Equals(Model.ViewFilter, ViewAll, StringComparison.OrdinalIgnoreCase))
                    {
                        <span> · <strong>@FormatViewFilter(Model.ViewFilter)</strong></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <span> · từ khóa "<strong>@Model.Search</strong>"</span>
                    }
                </p>
            </div>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 g-lg-4 job-grid">
                @foreach (var job in Model.Jobs)
                {
                    <div class="col d-flex">
                        <partial name="Shared/_JobGridCard" model="JobPortal.Web.Models.JobGridCardModel.FromEmployerManageJob(job, Model.ViewFilter, Model.Search, Model.CurrentPage, Model.PageSize)" />
                    </div>
                }
            </div>

            @if (Model.ShowPagination)
            {
                <nav class="mt-4" aria-label="Phân trang tin tuyển dụng">
                    <ul class="pagination justify-content-center flex-wrap mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Employer/Jobs"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-view="@Model.ViewFilter"
                               asp-route-q="@Model.Search"
                               aria-label="Trang trước">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Employer/Jobs"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-view="@Model.ViewFilter"
                                   asp-route-q="@Model.Search">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Employer/Jobs"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-view="@Model.ViewFilter"
                               asp-route-q="@Model.Search"
                               aria-label="Trang sau">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-muted small text-center mt-2 mb-0">
                        Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalCount tin
                    </p>
                </nav>
            }
            else if (Model.TotalCount > 0)
            {
                <p class="text-muted small text-center mt-3 mb-0">@Model.TotalCount tin</p>
            }
        }
    }
</div>

@section EmployerStyles {
    <link rel="stylesheet" href="~/css/employer-jobs.css" asp-append-version="true" />
}
