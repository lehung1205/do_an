@page
@model JobPortal.Web.Pages.Employer.JobsModel
@{
    ViewData["Title"] = "Tin tuyển dụng";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-briefcase me-2"></i>Tin tuyển dụng</h2>
            <p class="text-muted mb-0">Quản lý các tin đã đăng của công ty bạn</p>
        </div>
        <a asp-page="/Employer/PostJob" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Đăng tin mới
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else if (Model.Jobs.Count == 0)
    {
        <div class="employer-panel text-center py-5 text-muted">
            Chưa có tin nào. <a asp-page="/Employer/PostJob">Đăng tin đầu tiên</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var job in Model.Jobs)
            {
                var isRecruiting = string.Equals(job.PostingStatus, "recruiting", StringComparison.OrdinalIgnoreCase);
                var isClosed = string.Equals(job.PostingStatus, "closed", StringComparison.OrdinalIgnoreCase);
                <div class="employer-panel">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                        <h3 class="h6 mb-0 fw-semibold">@job.Title</h3>
                        <span class="badge @(isRecruiting ? "employer-badge--open" : isClosed ? "bg-secondary" : "employer-badge--draft")">
                            @JobPortal.Web.Pages.Employer.JobsModel.FormatJobStatus(job.PostingStatus)
                        </span>
                    </div>
                    <p class="text-muted small mb-2">
                        <i class="bi bi-geo-alt me-1"></i>@job.Location
                        · <i class="bi bi-cash-stack me-1"></i>@JobPortal.Web.Pages.Employer.JobsModel.FormatSalary(job.Salary)
                        · @job.ApplicantCount ứng viên
                        @if (!string.IsNullOrWhiteSpace(job.WorkingHours))
                        {
                            <text>· <i class="bi bi-clock"></i> @job.WorkingHours</text>
                        }
                        · Hết hạn @job.ExpiryDate.ToLocalTime().ToString("dd/MM/yyyy")
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        @if (isRecruiting || isClosed)
                        {
                            <a asp-page="/Employer/Applicants" class="btn btn-sm btn-outline-primary">Xem CV</a>
                            <a asp-page="/Jobs/Detail" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        }
                        else
                        {
                            <a asp-page="/Employer/PostJob" class="btn btn-sm btn-primary">Tiếp tục chỉnh sửa</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
