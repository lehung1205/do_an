@model JobPortal.Web.ViewComponents.EmployerPortalNavViewModel

<aside class="employer-dash__sidebar" aria-label="Menu nhà tuyển dụng">
    <a asp-page="/Index" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.Dashboard) ? "is-active" : "")">
        <span><i class="bi bi-grid-1x2-fill"></i> Bảng thông tin</span>
    </a>

    <div class="employer-dash__nav-group">
        <div class="employer-dash__nav-group-title">Quản lý tin tuyển dụng</div>
        <a asp-page="/Employer/Jobs" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.Jobs) ? "is-active" : "")">
            <span><i class="bi bi-briefcase"></i> Danh sách việc làm</span>
            <span class="employer-dash__badge">@Model.Nav.TotalJobs</span>
        </a>
        <a asp-page="/Employer/PostJob" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.PostJob) ? "is-active" : "")">
            <span><i class="bi bi-plus-circle"></i> Tạo việc làm mới</span>
        </a>
    </div>

    <div class="employer-dash__nav-group">
        <div class="employer-dash__nav-group-title">Quản lý ứng viên</div>
        <a asp-page="/Employer/Applicants" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.Applicants) ? "is-active" : "")">
            <span><i class="bi bi-people"></i> Ứng viên ứng tuyển</span>
            @if (Model.Nav.UnreadApplications > 0)
            {
                <span class="employer-dash__badge employer-dash__badge--highlight">@Model.Nav.UnreadApplications</span>
            }
        </a>
        <a asp-page="/Employer/WorkProgress/Index" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.WorkProgress) ? "is-active" : "")">
            <span><i class="bi bi-kanban"></i> Tiến độ công việc</span>
        </a>
        <a asp-page="/Notifications/Index" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.Notifications) ? "is-active" : "")">
            <span><i class="bi bi-bell"></i> Thông báo</span>
            @if (Model.Nav.UnreadNotifications > 0)
            {
                <span class="employer-dash__badge employer-dash__badge--highlight">@Model.Nav.UnreadNotifications</span>
            }
        </a>
        <a asp-page="/Messages/Index" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.Messages) ? "is-active" : "")">
            <span><i class="bi bi-chat-dots"></i> Tin nhắn</span>
            @if (Model.Nav.UnreadMessages > 0)
            {
                <span class="employer-dash__badge employer-dash__badge--highlight">@Model.Nav.UnreadMessages</span>
            }
        </a>
    </div>

    <div class="employer-dash__nav-group">
        <a asp-page="/Employer/BuyPackages" class="employer-dash__nav-link @(Model.IsActive(EmployerPortalNavKeys.Packages) ? "is-active" : "")">
            <span><i class="bi bi-bag-heart"></i> Mua gói dịch vụ</span>
        </a>
        <a asp-page="/Privacy" class="employer-dash__nav-link">
            <span><i class="bi bi-shield-check"></i> Chính sách</span>
        </a>
    </div>
</aside>
