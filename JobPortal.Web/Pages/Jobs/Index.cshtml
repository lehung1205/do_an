@page
@model JobPortal.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Việc làm";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Danh sách việc làm</h2>
            <p class="text-muted mb-0">Tìm việc phù hợp theo từ khóa và địa điểm</p>
        </div>
        <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-house me-1"></i> Trang chủ
        </a>
    </div>

    <form method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="q">Từ khóa</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="search" class="form-control" id="q" name="q" value="@Model.Q"
                               placeholder="Tiêu đề, mô tả, lương, công ty..." maxlength="200" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="location">Địa điểm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-geo-alt"></i>
                        </span>
                        <input type="search" class="form-control" id="location" name="location" value="@Model.Location"
                               placeholder="VD: Hà Nội, TP.HCM..." maxlength="200" />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                    <a asp-page="/Jobs/Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </div>
    </form>

    @if (Model.Jobs.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5 text-muted">
            @if (Model.HasActiveFilter)
            {
                <i class="bi bi-funnel display-6 d-block mb-2"></i>
                <p class="mb-2">Không có việc làm phù hợp bộ lọc.</p>
                <a asp-page="/Jobs/Index" class="btn btn-sm btn-outline-primary">Xóa bộ lọc</a>
            }
            else
            {
                <p class="mb-0">Chưa có tin tuyển dụng nào.</p>
            }
        </div>
    }
    else
    {
        @if (Model.TotalCount > 0)
        {
            <p class="text-muted small mb-3">@Model.TotalCount việc làm đang tuyển</p>
        }

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 g-lg-4 job-grid">
            @foreach (var job in Model.Jobs)
            {
                <div class="col d-flex">
                    <partial name="Shared/_JobGridCard" model="JobPortal.Web.Models.JobGridCardModel.FromJobDto(job)" />
                </div>
            }
        </div>

        @if (Model.ShowPagination)
        {
            <p class="text-muted small text-center mb-2 mt-4">
                Trang @Model.CurrentPage / @Model.TotalPages
            </p>
            <nav class="mt-3" aria-label="Phân trang danh sách việc làm">
                <ul class="pagination justify-content-center flex-wrap mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="/Jobs/Index"
                           asp-route-pageNumber="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-q="@Model.Q"
                           asp-route-location="@Model.Location"
                           aria-label="Trang trước">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-page="/Jobs/Index"
                               asp-route-pageNumber="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-q="@Model.Q"
                               asp-route-location="@Model.Location">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="/Jobs/Index"
                           asp-route-pageNumber="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-q="@Model.Q"
                           asp-route-location="@Model.Location"
                           aria-label="Trang sau">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
